@using {{ .Project }}.Application
@model {{ .Aggregate }}Request
@{
    ViewData["Title"] = "Edit {{ .Aggregate }}";
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">{{ .Aggregate }}s</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<h1 class="h3 mb-4">Edit {{ .Aggregate }}</h1>

<div class="card">
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger"></div>
        }
        <form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post">
            <input asp-for="Version" type="hidden" />
{{- range .Properties }}
            <div class="mb-3">
                <label class="form-label">{{ .DisplayName }}</label>
{{- if .RelationTarget }}
                <select asp-for="{{ .Name }}" class="form-select">
                    <option value="">Select {{ .DisplayName }}</option>
                    @foreach (var option in (List<{{ .RelationTarget }}View>)ViewBag.{{ .RelationTarget }}Items)
                    {
                        <option value="@option.Id">@option.{{ .RelationDisplayProperty }}</option>
                    }
                </select>
{{- else }}
                <input asp-for="{{ .Name }}" class="form-control" />
{{- end }}
                <span asp-validation-for="{{ .Name }}" class="text-danger small"></span>
            </div>
{{- end }}
{{- range .ManyToMany }}
            <div class="mb-3">
                <label class="form-label">{{ .DisplayName }}</label>
                <div class="border rounded p-3">
                    @foreach (var option in (List<{{ .Target }}View>)ViewBag.{{ .Target }}Items)
                    {
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="selected{{ .Target }}Ids" value="@option.Id" checked="@(((List<long>)ViewBag.{{ .Target }}SelectedIds).Contains(option.Id))" />
                            <label class="form-check-label">@option.{{ .DisplayProperty }}</label>
                        </div>
                    }
                </div>
            </div>
{{- end }}
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
