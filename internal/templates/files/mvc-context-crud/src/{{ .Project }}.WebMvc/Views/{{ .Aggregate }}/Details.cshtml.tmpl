@using {{ .Project }}.Application
@model {{ .Aggregate }}View
@{
    ViewData["Title"] = "{{ .Aggregate }} details";
}
<h1>{{ .Aggregate }} details</h1>
<dl class="row">
{{- range .Properties }}
    <dt class="col-sm-3">{{ .DisplayName }}</dt>
{{- if .RelationTarget }}
    <dd class="col-sm-9">@(((List<{{ .RelationTarget }}View>)ViewBag.{{ .RelationTarget }}Items).FirstOrDefault(x => x.Id == Model.{{ .Name }})?.{{ .RelationDisplayProperty }})</dd>
{{- else }}
    <dd class="col-sm-9">@Model.{{ .Name }}</dd>
{{- end }}
{{- end }}
</dl>
<div class="mb-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline" onsubmit="return confirm('Delete this {{ .Aggregate }}?');">
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
    <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
</div>
{{- range .ReverseRelations }}
<h3>{{ .DisplayName }}</h3>
<table class="table">
    <thead>
        <tr>
{{- range $.Properties }}
{{- if not .RelationTarget }}
            <th>{{ .DisplayName }}</th>
{{- end }}
{{- end }}
        </tr>
    </thead>
    <tbody>
    @foreach (var child in (List<{{ .SourceEntity }}View>)ViewBag.{{ .DisplayName }})
    {
        <tr>
{{- range $.Properties }}
{{- if not .RelationTarget }}
            <td>@child.{{ .Name }}</td>
{{- end }}
{{- end }}
        </tr>
    }
    </tbody>
</table>
{{- end }}
<!-- aspgen:children -->

