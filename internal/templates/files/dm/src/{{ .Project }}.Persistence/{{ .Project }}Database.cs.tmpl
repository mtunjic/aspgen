using Microsoft.EntityFrameworkCore;
using {{ .Project }}.DomainModel;

namespace {{ .Project }}.Persistence;

public partial class {{ .Project }}Database(DbContextOptions<{{ .Project }}Database> options) : DbContext(options)
{
    public DbSet<SampleRecord> SampleRecords => Set<SampleRecord>();

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        modelBuilder.Entity<SampleRecord>(x =>
        {
            x.HasKey(r => r.Id);
            x.ComplexProperty(r => r.Created).IsRequired();
            x.ComplexProperty(r => r.LastUpdated).IsRequired();
        });
        // Per-aggregate mapping lives in IEntityTypeConfiguration classes discovered by assembly scan.
        modelBuilder.ApplyConfigurationsFromAssembly(typeof({{ .Project }}Database).Assembly);
    }

    public async Task<CommandResponse> TrySaveChangesAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            await SaveChangesSafelyAsync(cancellationToken);
            return CommandResponse.Ok();
        }
        catch (Exception ex)
        {
            return CommandResponse.Fail().AddMessage("The operation failed.").AddExtra(ex.Message);
        }
    }

    // SaveChangesAsync wrapper that resets the change tracker when the save
    // fails. A failed save leaves the offending entities tracked (Added or
    // Modified); on a shared, long-lived DbContext (the dm-tier desktop
    // modules register ONE singleton database for the whole app) every later
    // SaveChangesAsync would retry the same broken rows and fail with a
    // confusing foreign-key error. Reset so one bad row can't poison
    // unrelated saves.
    public async Task<int> SaveChangesSafelyAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            return await SaveChangesAsync(cancellationToken);
        }
        catch
        {
            ChangeTracker.Clear();
            throw;
        }
    }
}

public sealed class SampleRecord : BaseEntity
{
    public long Id { get; set; }
    public string Name { get; set; } = "";
}
