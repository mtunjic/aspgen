@model {{ .Project }}.WebMvc.Models.IndexViewModelBase
@functions {
    static long RowId(object item) => (long)item.GetType().GetProperty("Id")!.GetValue(item)!;
}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    @foreach (var column in Model.Columns)
                    {
                        <th>@column.Label</th>
                    }
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    @foreach (var column in Model.Columns)
                    {
                        <td>@IndexViewModelBase.Display(item, column)</td>
                    }
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@RowId(item)" class="btn btn-sm btn-outline-primary">Details</a>
                        <a asp-action="Edit" asp-route-id="@RowId(item)" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@RowId(item)" method="post" style="display:inline" onsubmit="return confirm('Delete this record?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="99" class="text-center text-muted py-4">@Model.EmptyMessage</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
