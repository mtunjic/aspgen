@model {{ .Project }}.WebMvc.Models.IndexViewModelBase
<div class="card mb-4">
    <div class="card-header">Search &amp; filter</div>
    <div class="card-body">
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="@Model.SearchPlaceholder" />
            <button type="submit" class="btn btn-outline-primary">Search</button>
            @foreach (var hidden in Model.FilterFields)
            {
                <input type="hidden" name="@hidden.Name" value="@hidden.CurrentValue" />
            }
        </form>
        @if (Model.SortableFields.Count > 0)
        {
            <form method="get" class="d-flex gap-2 align-items-center mt-2">
                <label class="form-label small mb-0">Sort by</label>
                <select name="sortBy" class="form-select form-select-sm" style="width:auto">
                    <option value="">Id</option>
                    @foreach (var field in Model.SortableFields)
                    {
                        <option value="@field.Name" selected="@(Model.SortBy == field.Name)">@field.Label</option>
                    }
                </select>
                <div class="form-check mb-0">
                    <input type="checkbox" class="form-check-input" id="sortDesc" name="sortDesc" value="true" checked="@Model.SortDesc" />
                    <label class="form-check-label small" for="sortDesc">Descending</label>
                </div>
                <input type="hidden" name="search" value="@Model.Search" />
            </form>
        }
        <details class="mt-3" open="@(Model.HasActiveFilters)">
            <summary class="text-secondary small">Advanced filters</summary>
            <form method="get" class="row g-2 mt-1">
                <input type="hidden" name="search" value="@Model.Search" />
                @foreach (var field in Model.FilterFields)
                {
                    <div class="col-auto">
                        <label class="form-label small">@field.Label</label>
                        @switch (field.Kind)
                        {
                            case "string":
                                <input type="text" name="@field.Name" value="@field.CurrentValue" class="form-control form-control-sm" />
                                break;
                            case "number":
                                <input type="number" name="@field.Name" value="@field.CurrentValue" class="form-control form-control-sm" />
                                break;
                            case "date":
                                <input type="date" name="@field.Name" value="@field.CurrentValue" class="form-control form-control-sm" />
                                break;
                            case "bool":
                                <select name="@field.Name" class="form-select form-select-sm">
                                    <option value="">Any</option>
                                    <option value="true" selected="@(field.CurrentValue == "true")">Yes</option>
                                    <option value="false" selected="@(field.CurrentValue == "false")">No</option>
                                </select>
                                break;
                            case "relation":
                                <select name="@field.Name" class="form-select form-select-sm">
                                    <option value="">Any</option>
                                    @foreach (var option in field.Options ?? Array.Empty<SelectOption>())
                                    {
                                        <option value="@option.Id" selected="@(field.CurrentValue == option.Id.ToString())">@option.Display</option>
                                    }
                                </select>
                                break;
                        }
                    </div>
                }
                <div class="col-auto align-self-end">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
                    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                </div>
            </form>
        </details>
    </div>
</div>
