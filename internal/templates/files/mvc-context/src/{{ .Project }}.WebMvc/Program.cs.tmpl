using FluentValidation;
using Microsoft.EntityFrameworkCore;
using {{ .Project }}.Persistence;

var builder = WebApplication.CreateBuilder(args);
builder.Services.AddControllersWithViews();
builder.Services.AddValidatorsFromAssemblyContaining<{{ .Project }}.Application.ApplicationServiceBase>();
var connectionString = builder.Configuration.GetConnectionString("DefaultConnection")
{{- if eq .Database "postgres" }}
    ?? "Host=localhost;Database={{ kebab .Project }};Username=postgres;Password=postgres";
builder.Services.AddDbContext<{{ .Project }}Database>(options => options.UseNpgsql(connectionString));
{{- else }}
    ?? "Data Source={{ .Project }}.db";
builder.Services.AddDbContext<{{ .Project }}Database>(options => options.UseSqlite(connectionString));
{{- end }}
// aspgen:services

var app = builder.Build();
app.UseStaticFiles();
app.UseRouting();
app.MapControllers();
app.MapControllerRoute(name: "default", pattern: "{controller=Home}/{action=Index}/{id?}");

// Dev-time schema bootstrap; switch to `dotnet ef database update` once the
// schema needs real migrations (EnsureCreated and migrations do not mix).
using (var scope = app.Services.CreateScope())
{
    scope.ServiceProvider.GetRequiredService<{{ .Project }}Database>().Database.EnsureCreated();
}

app.Run();

public partial class Program { }
