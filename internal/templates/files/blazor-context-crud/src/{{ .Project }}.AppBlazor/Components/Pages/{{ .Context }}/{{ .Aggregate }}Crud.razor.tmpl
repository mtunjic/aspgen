@using System.Net.Http.Json
@page "/{{ kebab .Context }}/{{ kebab .Aggregate }}s"
@using {{ .Project }}.Application
@using {{ .Project }}.Application.Features.{{ .Context }}.{{ .Aggregate }}
@using {{ .Project }}.AppBlazor.Components.Shared
@inherits CrudPageBase<{{ .Aggregate }}View>

<CrudHeader Title="{{ .Aggregate }}s" CreatePath="/{{ kebab .Context }}/{{ kebab .Aggregate }}s/edit" />

<SearchFilterBar Filters="@filters" SearchText="@searchText" SearchTextChanged="@((string? v) => OnSearchTextChanged(v))"
                 Apply="@(() => SearchAsync())" Clear="@(() => ClearFiltersAsync())" SearchPlaceholder="Search {{ .Aggregate }}s..." />

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<EntityTable Items="@items" Columns="@columns" EmptyMessage="No {{ .Aggregate }}s found."
             OnRowClick="@(({{ .Aggregate }}View item) => ViewDetails(item))"
             OnEdit="@(({{ .Aggregate }}View item) => EditItem(item))"
             OnDelete="@(({{ .Aggregate }}View item) => DeleteItem(item))" />

<PaginationBar HasMore="@hasMore" Count="@totalCount" OnLoadMore="@(() => LoadMoreAsync())" />

@code {
    protected override string ApiPath => "/api/{{ kebab .Context }}/{{ kebab .Aggregate }}";
    protected override string ListPath => "/{{ kebab .Context }}/{{ kebab .Aggregate }}s";

    private string? searchText;
    private List<FilterField> filters = [];
    private List<EntityColumn<{{ .Aggregate }}View>> columns = [];
{{- range .Relations }}
    private List<{{ .Target }}View> {{ .Target }}Items = [];
{{- end }}
{{- range .Properties }}
{{- if .RelationTarget }}
    private long? filter{{ .Name }};
{{- else if eq (filterKind .CSharpType) "string" }}
    private string? filter{{ .Name }}Contains;
{{- else if eq (filterKind .CSharpType) "numeric" }}
    private {{ trimSuffix .CSharpType "?" }}? filter{{ .Name }}Min;
    private {{ trimSuffix .CSharpType "?" }}? filter{{ .Name }}Max;
{{- else if eq (filterKind .CSharpType) "date" }}
    private {{ trimSuffix .CSharpType "?" }}? filter{{ .Name }}Min;
    private {{ trimSuffix .CSharpType "?" }}? filter{{ .Name }}Max;
{{- else if eq (filterKind .CSharpType) "bool" }}
    private bool? filter{{ .Name }};
{{- end }}
{{- end }}
{{- range .Properties }}{{- if ne (relationNestedFilterField .) "" }}
    private string? filter{{ relationNestedFilterField . }};
{{- end }}{{- end }}

    protected override async Task OnInitializedAsync()
    {
{{- range .Relations }}
        {{ .Target }}Items = await Http.GetFromJsonAsync<List<{{ .Target }}View>>("/api/{{ kebab $.Context }}/{{ kebab .Target }}") ?? [];
{{- end }}
        BuildColumns();
        BuildFilters();
        await SearchAsync();
    }

    private void BuildColumns()
    {
        columns = new List<EntityColumn<{{ .Aggregate }}View>>
        {
{{- range .Properties }}
{{- if .RelationTarget }}
            new() { Label = "{{ .DisplayName }}", Display = x => {{ .RelationTarget }}Items.FirstOrDefault(r => r.Id == x.{{ .Name }})?.{{ .RelationDisplayProperty }} },
{{- else }}
            new() { Label = "{{ .DisplayName }}", Display = x => x.{{ .Name }} },
{{- end }}
{{- end }}
        };
    }

    private void BuildFilters()
    {
        filters = new List<FilterField>
        {
{{- range .Properties }}
{{- if .RelationTarget }}
            new() { Label = "{{ .DisplayName }}", Kind = "relation",
                    Options = {{ .RelationTarget }}Items.Select(x => new FilterOption(x.Id, x.{{ .RelationDisplayProperty }})).ToList(),
                    GetValue = () => filter{{ .Name }}, SetValue = v => filter{{ .Name }} = ParseLong(v) },
{{- else if eq (filterKind .CSharpType) "string" }}
            new() { Label = "{{ .DisplayName }} contains", Kind = "string",
                    GetValue = () => filter{{ .Name }}Contains, SetValue = v => filter{{ .Name }}Contains = v as string },
{{- else if eq (filterKind .CSharpType) "numeric" }}
            new() { Label = "{{ .DisplayName }} min", Kind = "number",
                    GetValue = () => filter{{ .Name }}Min, SetValue = v => filter{{ .Name }}Min = ParseNumber<{{ trimSuffix .CSharpType "?" }}>(v) },
            new() { Label = "{{ .DisplayName }} max", Kind = "number",
                    GetValue = () => filter{{ .Name }}Max, SetValue = v => filter{{ .Name }}Max = ParseNumber<{{ trimSuffix .CSharpType "?" }}>(v) },
{{- else if eq (filterKind .CSharpType) "date" }}
            new() { Label = "{{ .DisplayName }} from", Kind = "date",
                    GetValue = () => filter{{ .Name }}Min, SetValue = v => filter{{ .Name }}Min = {{ if eq (trimSuffix .CSharpType "?") "DateTime" }}ParseDateTime(v){{ else }}ParseDate(v){{ end }} },
            new() { Label = "{{ .DisplayName }} to", Kind = "date",
                    GetValue = () => filter{{ .Name }}Max, SetValue = v => filter{{ .Name }}Max = {{ if eq (trimSuffix .CSharpType "?") "DateTime" }}ParseDateTime(v){{ else }}ParseDate(v){{ end }} },
{{- else if eq (filterKind .CSharpType) "bool" }}
            new() { Label = "{{ .DisplayName }}", Kind = "bool",
                    GetValue = () => filter{{ .Name }}, SetValue = v => filter{{ .Name }} = ParseBool(v) },
{{- end }}
{{- end }}
{{- range .Properties }}{{- if ne (relationNestedFilterField .) "" }}
            new() { Label = "{{ .RelationTarget }} {{ .RelationDisplayProperty }} contains", Kind = "string",
                    GetValue = () => filter{{ relationNestedFilterField . }}, SetValue = v => filter{{ relationNestedFilterField . }} = v as string },
{{- end }}{{- end }}
        };
    }

    protected override async Task<(List<{{ .Aggregate }}View> Items, long TotalCount)> FetchPageAsync(int page)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(searchText)) query.Add($"search={Uri.EscapeDataString(searchText)}");
{{- range .Properties }}
{{- if .RelationTarget }}
        if (filter{{ .Name }}.HasValue) query.Add($"{{ camel .Name }}={filter{{ .Name }}.Value}");
{{- else if eq (filterKind .CSharpType) "string" }}
        if (!string.IsNullOrWhiteSpace(filter{{ .Name }}Contains)) query.Add($"{{ camel .Name }}Contains={Uri.EscapeDataString(filter{{ .Name }}Contains)}");
{{- else if eq (filterKind .CSharpType) "numeric" }}
        if (filter{{ .Name }}Min.HasValue) query.Add($"{{ camel .Name }}Min={filter{{ .Name }}Min.Value}");
        if (filter{{ .Name }}Max.HasValue) query.Add($"{{ camel .Name }}Max={filter{{ .Name }}Max.Value}");
{{- else if eq (filterKind .CSharpType) "date" }}
        if (filter{{ .Name }}Min.HasValue) query.Add($"{{ camel .Name }}Min={filter{{ .Name }}Min.Value:O}");
        if (filter{{ .Name }}Max.HasValue) query.Add($"{{ camel .Name }}Max={filter{{ .Name }}Max.Value:O}");
{{- else if eq (filterKind .CSharpType) "bool" }}
        if (filter{{ .Name }}.HasValue) query.Add($"{{ camel .Name }}={filter{{ .Name }}.Value}");
{{- end }}
{{- end }}
{{- range .Properties }}{{- if ne (relationNestedFilterField .) "" }}
        if (!string.IsNullOrWhiteSpace(filter{{ relationNestedFilterField . }})) query.Add($"{{ camel (relationNestedFilterField .) }}={Uri.EscapeDataString(filter{{ relationNestedFilterField . }})}");
{{- end }}{{- end }}
        query.Add($"page={page}");
        query.Add($"pageSize={PageSize}");
        var result = await Http.GetFromJsonAsync<{{ .Aggregate }}PagedResponse>($"{ApiPath}/search?{string.Join("&", query)}");
        return result is null ? ([], 0) : (result.Items.ToList(), result.TotalCount);
    }

    private void OnSearchTextChanged(string? value) => searchText = value;

    private async Task ClearFiltersAsync()
    {
        searchText = null;
{{- range .Properties }}
{{- if .RelationTarget }}
        filter{{ .Name }} = null;
{{- else if eq (filterKind .CSharpType) "string" }}
        filter{{ .Name }}Contains = null;
{{- else if eq (filterKind .CSharpType) "numeric" }}
        filter{{ .Name }}Min = null;
        filter{{ .Name }}Max = null;
{{- else if eq (filterKind .CSharpType) "date" }}
        filter{{ .Name }}Min = null;
        filter{{ .Name }}Max = null;
{{- else if eq (filterKind .CSharpType) "bool" }}
        filter{{ .Name }} = null;
{{- end }}
{{- end }}
{{- range .Properties }}{{- if ne (relationNestedFilterField .) "" }}
        filter{{ relationNestedFilterField . }} = null;
{{- end }}{{- end }}
        await SearchAsync();
    }

    private void ViewDetails({{ .Aggregate }}View item) => Navigation.NavigateTo($"{ListPath}/{item.Id}");
    private void EditItem({{ .Aggregate }}View item) => Navigation.NavigateTo($"{ListPath}/edit/{item.Id}");
    private void DeleteItem({{ .Aggregate }}View item) => _ = DeleteAsync(item.Id);

    private static long? ParseLong(object? v) => long.TryParse(v as string, out var id) ? id : null;
    private static bool? ParseBool(object? v)
    {
        var text = v as string;
        if (text == "true") return true;
        if (text == "false") return false;
        return null;
    }
    private static DateOnly? ParseDate(object? v) => DateOnly.TryParse(v as string, out var d) ? d : null;
    private static DateTime? ParseDateTime(object? v) => DateTime.TryParse(v as string, out var dt) ? dt : null;
    private static T? ParseNumber<T>(object? v) where T : struct, IParsable<T> =>
        v is not null && T.TryParse(v as string, null, out var result) ? result : null;
}
