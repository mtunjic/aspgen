@page "/{{ kebab .Context }}/{{ kebab .Aggregate }}s/{Id:long}"
@using System.Net.Http.Json
@using {{ .Project }}.Application
@using {{ .Project }}.Application.Features.{{ .Context }}.{{ .Aggregate }}
@inject HttpClient Http
@inject NavigationManager Navigation

<h1>{{ .Aggregate }} details</h1>

@if (item is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <dl class="row">
{{- range .Properties }}
        <dt class="col-sm-3">{{ .DisplayName }}</dt>
{{- if .RelationTarget }}
        <dd class="col-sm-9">@({{ .RelationTarget }}Items.FirstOrDefault(x => x.Id == item.{{ .Name }})?.{{ .RelationDisplayProperty }})</dd>
{{- else }}
        <dd class="col-sm-9">@item.{{ .Name }}</dd>
{{- end }}
{{- end }}
    </dl>
    <div class="mb-3">
        <button class="btn btn-secondary" @onclick="Edit">Edit</button>
        <button class="btn btn-danger" @onclick="DeleteAsync">Delete</button>
        <button class="btn btn-outline-secondary" @onclick="Back">Back</button>
    </div>
{{- range .ReverseRelations }}
    <h3>{{ .DisplayName }}</h3>
    <table class="table">
        <tbody>
        @foreach (var child in {{ .DisplayName }})
        {
            <tr>@child.ToString()</tr>
        }
        </tbody>
    </table>
{{- end }}
    @* aspgen:children *@
}

@code {
    [Parameter] public long Id { get; set; }
    private {{ .Aggregate }}View? item;
{{- range .Relations }}
    private List<{{ .Target }}View> {{ .Target }}Items = [];
{{- end }}
{{- range .ReverseRelations }}
    private List<{{ .SourceEntity }}View> {{ .DisplayName }} = [];
{{- end }}
    // aspgen:childrenFields

    protected override async Task OnInitializedAsync()
    {
        item = await Http.GetFromJsonAsync<{{ .Aggregate }}View>($"/api/{{ kebab .Context }}/{{ kebab .Aggregate }}/{Id}");
{{- range .Relations }}
        {{ .Target }}Items = await Http.GetFromJsonAsync<List<{{ .Target }}View>>("/api/{{ kebab $.Context }}/{{ kebab .Target }}") ?? [];
{{- end }}
{{- range .ReverseRelations }}
        {{ .DisplayName }} = (await Http.GetFromJsonAsync<List<{{ .SourceEntity }}View>>("/api/{{ kebab .SourceContext }}/{{ kebab .SourceEntity }}") ?? []).Where(x => x.{{ .FKProperty }} == Id).ToList();
{{- end }}
        // aspgen:childrenLoads
    }

    private void Edit() => Navigation.NavigateTo($"/{{ kebab .Context }}/{{ kebab .Aggregate }}s/edit/{Id}");

    private async Task DeleteAsync()
    {
        var response = await Http.DeleteAsync($"/api/{{ kebab .Context }}/{{ kebab .Aggregate }}/{Id}");
        if (!response.IsSuccessStatusCode) return;
        Navigation.NavigateTo("/{{ kebab .Context }}/{{ kebab .Aggregate }}s");
    }

    private void Back() => Navigation.NavigateTo("/{{ kebab .Context }}/{{ kebab .Aggregate }}s");
}

