using System.Windows;
using Prism.DryIoc;
using Prism.Ioc;
using Prism.Modularity;
using Prism.Navigation.Regions;
{{- if eq .Theme "wpfui" }}
using Wpf.Ui;
{{- end }}

namespace {{ .Project }}.Desktop;

public partial class App : PrismApplication
{
    protected override Window CreateShell() => Container.Resolve<Shell>();

    protected override void RegisterTypes(IContainerRegistry containerRegistry)
    {
        containerRegistry.RegisterForNavigation<Views.DashboardView>();
        containerRegistry.RegisterForNavigation<Views.SettingsView>();
{{- if eq .Theme "wpfui" }}
        containerRegistry.RegisterSingleton<Navigation.NavigationRegistry>();
        containerRegistry.RegisterSingleton<IContentDialogService, ContentDialogService>();
        containerRegistry.RegisterSingleton<ISnackbarService, SnackbarService>();
{{- end }}
    }

    protected override void OnInitialized()
    {
        Container.Resolve<IRegionManager>().RequestNavigate("MainRegion", "DashboardView");
        base.OnInitialized();
    }

    protected override void ConfigureModuleCatalog(IModuleCatalog moduleCatalog)
    {
        // aspgen:modules
    }

    // Disposing the container here (window close, File > Exit, Alt+F4 -- any
    // shutdown path that actually runs application code, unlike a hard kill
    // from Task Manager or `Stop-Process -Force`, which no process can
    // intercept) cascades into disposing every per-module singleton the
    // container tracks, e.g. each dm-tier module's own {{ .Project }}Database/
    // AppDbContext and each HTTP-tier module's HttpClient, so SQLite
    // connections and HTTP handles are released cleanly instead of lingering.
    protected override void OnExit(ExitEventArgs e)
    {
        if (Container is IDisposable disposableContainer)
        {
            disposableContainer.Dispose();
        }
        base.OnExit(e);
    }
}
