<UserControl x:Class="{{ .Project }}.Desktop.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"{{ if eq .Theme "wpfui" }}
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"{{ end }}
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource ApplicationBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <TextBlock Text="Settings" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,18" />
{{- if eq .Theme "wpfui" }}
            <ui:CardAction Padding="20">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Choose the color mode for this workspace." Margin="0,8,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Current mode:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding CurrentTheme}" Margin="6,0,0,0" FontWeight="SemiBold" />
                    </StackPanel>
                    <ui:Button Content="Toggle theme" Icon="{ui:SymbolIcon DarkTheme24}" Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:CardAction>
{{- else }}
            <Border Padding="20" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Theme settings are available when the WPF-UI theme is enabled." Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
{{- end }}
        </StackPanel>
    </ScrollViewer>
</UserControl>
