using Prism.Commands;
using Prism.Mvvm;
using Prism.Navigation;
using Prism.Navigation.Regions;

namespace {{ .Project }}.Desktop.Shared;

// Shared create/edit-view plumbing for every generated module: loading the
// record by navigation id, form reset, save + related-row sync, validation
// message and back-to-list navigation. Derived view models only supply the
// entity-specific form fields, related-item loading and save logic.
public abstract class EditViewModelBase<TStore, TRow, TForm> : BindableBase, INavigationAware
    where TStore : IEntityDataStore<TRow>
    where TRow : class, IEntityRow
    where TForm : class
{
    protected readonly IAppNavigationService Navigation;
    private readonly TStore store;
    protected long EditingId;
    // Optimistic-concurrency token of the record being edited (0 for a create).
    protected int EditingVersion;

    // The declaring aggregate's store, for operations the base wires through
    // the aggregate service (e.g. transactional many-to-many link replacement).
    protected TStore Store => store;
    private bool isBusy;
    private string validationMessage = string.Empty;
    private readonly Dictionary<string, string> fieldErrors = [];

    protected EditViewModelBase(TStore store, IAppNavigationService navigation)
    {
        this.store = store;
        Navigation = navigation;
        Form = CreateForm();
        SaveCommand = new DelegateCommand(Save, () => !IsBusy);
        CancelCommand = new DelegateCommand(Cancel, () => !IsBusy);
    }

    public bool IsNavigationTarget(NavigationContext navigationContext) => true;

    public void OnNavigatedFrom(NavigationContext navigationContext)
    {
    }

    public void OnNavigatedTo(NavigationContext navigationContext)
    {
        var id = navigationContext.Parameters.GetValue<long>("id");
        EditingId = id;
        TRow? item = id == 0 ? default : store.GetAll().FirstOrDefault(x => x.Id == id);
        // The version the form was loaded at, sent back on save for optimistic
        // concurrency (a stale edit is rejected with a conflict message).
        EditingVersion = item?.Version ?? 0;
        ResetForm(item);
        LoadRelated();
        ValidationMessage = string.Empty;
        ClearFieldErrors();
    }

    protected abstract TForm CreateForm();
    protected abstract void ResetForm(TRow? item);
    protected abstract void LoadRelated();
    protected abstract bool TryBuild(out TRow value);
    protected abstract void SyncRelated(TRow saved);
    public abstract string EntityName { get; }
    protected abstract string ListViewName { get; }

    public TForm Form { get; }
    public bool IsEditing => EditingId != 0;
    public string Title => IsEditing ? "Edit " + EntityName : "Create " + EntityName;
    public bool IsBusy
    {
        get => isBusy;
        protected set
        {
            if (SetProperty(ref isBusy, value))
            {
                SaveCommand.RaiseCanExecuteChanged();
                CancelCommand.RaiseCanExecuteChanged();
            }
        }
    }
    public string ValidationMessage
    {
        get => validationMessage;
        protected set
        {
            if (SetProperty(ref validationMessage, value))
            {
                RaisePropertyChanged(nameof(HasValidationError));
            }
        }
    }
    public bool HasValidationError => !string.IsNullOrWhiteSpace(ValidationMessage);

    // Per-field errors, keyed by property name (e.g. "Title"). The edit form's
    // generated fields bind an error label to FieldErrors[PropertyName], so a
    // failed field is highlighted inline instead of only showing the summary.
    public IReadOnlyDictionary<string, string> FieldErrors => fieldErrors;

    public string? FieldError(string property) => fieldErrors.GetValueOrDefault(property);

    public DelegateCommand SaveCommand { get; }
    public DelegateCommand CancelCommand { get; }

    private void RaiseFieldErrorsChanged() => RaisePropertyChanged(nameof(FieldErrors));

    protected void SetFieldError(string property, string message)
    {
        fieldErrors[property] = message;
        RaiseFieldErrorsChanged();
    }

    private void ClearFieldErrors()
    {
        if (fieldErrors.Count > 0)
        {
            fieldErrors.Clear();
            RaiseFieldErrorsChanged();
        }
    }

    protected bool Invalid(string propertyName)
    {
        ValidationMessage = $"{propertyName} is invalid.";
        SetFieldError(propertyName, $"{propertyName} is invalid.");
        return false;
    }

    private void Save()
    {
        ClearFieldErrors();
        if (!TryBuild(out var value)) return;
        IsBusy = true;
        try
        {
            var saved = store.Save(EditingId, value);
            SyncRelated(saved);
            Navigation.GoTo(ListViewName);
        }
        catch (ConcurrencyConflictException ex)
        {
            // Someone else saved this record since the form loaded; tell the
            // user to reload rather than pretending the edit went through.
            AppLog.Warning("Save conflicted for {Entity}: {Message}", EntityName, ex.Message);
            ValidationMessage = ex.Message;
        }
        catch (Exception ex)
        {
            // Full detail always goes to the structured log; the user only
            // sees an honest, actionable message. Server-side FluentValidation
            // failures highlight each field; a foreign-key violation really
            // does mean a related record is missing; anything else is reported
            // generically instead of blaming a relation.
            AppLog.Error(ex, "Save failed for {Entity}", EntityName);
            if (ApplyValidationErrors(ex))
            {
                ValidationMessage = "Please fix the highlighted fields.";
            }
            else
            {
                ValidationMessage = IsForeignKeyFailure(ex)
                    ? $"Could not save {EntityName}. You must add its related record(s) first."
                    : $"Could not save {EntityName}. Something went wrong; the details have been logged.";
            }
        }
        finally
        {
            IsBusy = false;
        }
    }

    // Extracts FluentValidation's per-field errors (ValidationException.Errors
    // -> ValidationFailure{PropertyName, ErrorMessage}) without referencing the
    // type directly: the shared base also compiles into HTTP-backed cqrs/es
    // desktops that do not ship FluentValidation.
    private bool ApplyValidationErrors(Exception ex)
    {
        if (ex.GetType().Name != "ValidationException") return false;
        var errors = ex.GetType().GetProperty("Errors")?.GetValue(ex) as System.Collections.IEnumerable;
        if (errors is null) return false;
        var applied = false;
        foreach (var failure in errors)
        {
            var property = failure?.GetType().GetProperty("PropertyName")?.GetValue(failure) as string;
            var message = failure?.GetType().GetProperty("ErrorMessage")?.GetValue(failure) as string;
            if (!string.IsNullOrWhiteSpace(property) && !string.IsNullOrWhiteSpace(message))
            {
                fieldErrors[property] = message;
                applied = true;
            }
        }
        if (applied) RaiseFieldErrorsChanged();
        return applied;
    }

    // Detects a foreign-key constraint violation without depending on EF Core
    // (the shared base also compiles into HTTP-backed cqrs/es desktops where
    // failures surface as HttpRequestException instead). The provider-agnostic
    // wording ("FOREIGN KEY constraint failed" on SQLite, "violates foreign
    // key constraint" on PostgreSQL) is matched anywhere in the inner chain.
    private static bool IsForeignKeyFailure(Exception ex)
    {
        for (Exception? e = ex; e is not null; e = e.InnerException)
        {
            var message = e.Message;
            if (message.Contains("FOREIGN KEY", System.StringComparison.OrdinalIgnoreCase) ||
                message.Contains("constraint failed", System.StringComparison.OrdinalIgnoreCase) ||
                message.Contains("violates foreign key", System.StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        return false;
    }

    private void Cancel() => Navigation.GoTo(ListViewName);
}
