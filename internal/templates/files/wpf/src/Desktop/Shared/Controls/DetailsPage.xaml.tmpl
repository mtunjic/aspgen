<UserControl x:Class="{{ .Project }}.Desktop.Shared.Controls.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"{{ if eq .Theme "wpfui" }}
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"{{ end }}>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Header with separator -->
        <Border Grid.Row="0" Style="{StaticResource ListHeaderStyle}">
            <DockPanel LastChildFill="False">
{{- if eq .Theme "wpfui" }}
                <ui:TextBlock DockPanel.Dock="Left" FontTypography="TitleLarge" Text="{Binding EntityName, StringFormat={}{0} details}" />
                <ui:Button DockPanel.Dock="Right" Padding="12,6" Content="Back" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding BackCommand}" />
{{- else }}
                <TextBlock DockPanel.Dock="Left" FontSize="24" FontWeight="SemiBold" Text="{Binding EntityName, StringFormat={}{0} details}" />
                <Button DockPanel.Dock="Right" Padding="12,6" Content="Back" Command="{Binding BackCommand}" />
{{- end }}
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsFound, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="680" HorizontalAlignment="Left" Style="{StaticResource CardStyle}">
                <ContentPresenter Content="{Binding FieldsContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Border>
        </ScrollViewer>
{{- if eq .Theme "wpfui" }}
        <ui:InfoBar Grid.Row="1" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsOpen="{Binding IsNotFound}" IsClosable="False" Severity="Informational" Title="{Binding EntityName, StringFormat={}{0} not found}" Message="The record may have been deleted." />
{{- else }}
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsNotFound, Converter={StaticResource BoolToVisibility}}" FontWeight="SemiBold" Text="{Binding EntityName, StringFormat={}{0} not found}" />
{{- end }}
    </Grid>
</UserControl>
