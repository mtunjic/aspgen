<UserControl x:Class="{{ .Project }}.Desktop.Shared.Controls.ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"{{ if eq .Theme "wpfui" }}
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"{{ end }}>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ViewDetailsCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header with separator -->
        <Border Grid.Row="0" Style="{StaticResource ListHeaderStyle}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
{{- if eq .Theme "wpfui" }}
                    <ui:TextBlock FontTypography="TitleLarge" Text="{Binding EntityName}" />
                    <ui:TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Body" Text="{Binding EntityName, StringFormat=Manage {0} records.}" />
{{- else }}
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding EntityName}" />
{{- end }}
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
{{- if eq .Theme "wpfui" }}
                    <ui:ProgressRing Width="20" Height="20" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Margin="4,0,0,0" Padding="14,7" Appearance="Primary" Content="{Binding EntityName, StringFormat=Add new {0}}" Icon="{ui:SymbolIcon Add24}" ToolTip="{Binding EntityName, StringFormat=Create a new {0}}" Command="{Binding NewCommand}" />
{{- else }}
                    <Button Margin="4,0,0,0" Padding="12,6" FontWeight="SemiBold" Content="{Binding EntityName, StringFormat=Add new {0}}" Command="{Binding NewCommand}" />
{{- end }}
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search & filter card -->
        <Border Grid.Row="1" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
            <StackPanel>
{{- if eq .Theme "wpfui" }}
                <ui:TextBlock Style="{StaticResource SectionHeaderStyle}" Text="SEARCH &amp; FILTER" />
{{- else }}
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="SEARCH &amp; FILTER" />
{{- end }}
                <DockPanel>
{{- if eq .Theme "wpfui" }}
                    <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Content="Search" Icon="{ui:SymbolIcon Search24}" Command="{Binding SearchCommand}" />
                    <ui:TextBox ClearButtonEnabled="True" PlaceholderText="{Binding EntityName, StringFormat=Search {0} records...}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
{{- else }}
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Content="Search" Command="{Binding SearchCommand}" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
{{- end }}
                </DockPanel>
                <Expander Margin="0,10,0,0" Header="Advanced filters" IsExpanded="{Binding IsAdvancedFilterExpanded, Mode=TwoWay}">
                    <StackPanel Margin="0,10,0,0">
                        <ContentPresenter Content="{Binding FilterFields, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
{{- if eq .Theme "wpfui" }}
                            <ui:Button Content="Apply" Command="{Binding SearchCommand}" />
                            <ui:Button Margin="8,0,0,0" Content="Clear" Command="{Binding ClearFiltersCommand}" />
{{- else }}
                            <Button Content="Apply" Command="{Binding SearchCommand}" />
                            <Button Margin="8,0,0,0" Content="Clear" Command="{Binding ClearFiltersCommand}" />
{{- end }}
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

{{- if eq .Theme "wpfui" }}
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ui:ListView Margin="0,0,0,8" ItemsSource="{Binding Items}" SelectionMode="Single" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        ItemTemplate="{Binding RowTemplate, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ui:ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ui:ListView.ItemContainerStyle>
            </ui:ListView>
        </ScrollViewer>
        <ui:InfoBar Grid.Row="2" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsOpen="{Binding IsEmpty}" IsClosable="False" Severity="Informational" Title="{Binding EntityName, StringFormat=No {0} records}" Message="{Binding EntityName, StringFormat=Create a new {0} to get started.}" />
{{- else }}
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ListView Margin="0,0,0,8" ItemsSource="{Binding Items}" SelectionMode="Single" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      ItemTemplate="{Binding RowTemplate, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </ScrollViewer>
{{- end }}
{{- if eq .Theme "wpfui" }}
        <DockPanel Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Center">
            <ui:Button Margin="0,0,8,0" Content="Prev" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding PrevPageCommand}" />
            <ui:TextBlock VerticalAlignment="Center" Text="{Binding PageLabel}" />
            <ui:Button Margin="8,0,0,0" Content="Next" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding NextPageCommand}" />
        </DockPanel>
{{- else }}
        <DockPanel Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Center">
            <Button Margin="0,0,8,0" Padding="12,6" Content="Prev" Command="{Binding PrevPageCommand}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding PageLabel}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Next" Command="{Binding NextPageCommand}" />
        </DockPanel>
{{- end }}
    </Grid>
</UserControl>
