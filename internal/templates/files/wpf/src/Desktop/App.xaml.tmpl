<prism:PrismApplication x:Class="{{ .Project }}.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"{{ if eq .Theme "wpfui" }}
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"{{ end }}>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
{{- if eq .Theme "wpfui" }}
                <ui:ThemesDictionary Theme="{{ .ThemeMode }}" />
                <ui:ControlsDictionary />
{{- end }}
                <ResourceDictionary Source="Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
