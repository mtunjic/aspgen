using System.Net.Http.Json;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.Extensions.Hosting;
using Xunit;
using {{ .Project }}.Application;
using {{ .Project }}.Application.Features.{{ .Context }}.{{ .Aggregate }};
{{- range .RelationTest.ManyToMany }}
using {{ $.Project }}.Application.Features.{{ $.Context }}.{{ .JoinEntity }};
{{- end }}

namespace {{ .Project }}.IntegrationTests;

// Exercises the exact HTTP contract the generated Blazor page and the WPF
// HTTP Store rely on: create the related entities and join rows through the
// WebApi, then query them back by foreign key. Each test gets its own fresh
// SQLite file (via a per-run connection string) so runs stay isolated and
// idempotent.
public class {{ .Aggregate }}RelationApiTests
{
    [Fact]
    public async Task CreateRelatedDataAndQueryItBack()
    {
        using var factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
            builder.UseSetting("ConnectionStrings:DefaultConnection", $"Data Source=rel-{Guid.NewGuid():N}.db"));
        var client = factory.CreateClient();

{{- range .RelationTest.Prereqs }}
        var {{ .Var }}Response = await client.PostAsJsonAsync("/api/{{ kebab $.Context }}/{{ kebab .Target }}", new {{ .Target }}Request({{ range $i, $a := .RequestArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}));
        {{ .Var }}Response.EnsureSuccessStatusCode();
        var {{ .Var }} = await {{ .Var }}Response.Content.ReadFromJsonAsync<{{ .Target }}View>();
{{- end }}
{{- range .RelationTest.Relations }}
        var {{ .Var }}Response = await client.PostAsJsonAsync("/api/{{ kebab $.Context }}/{{ kebab .Target }}", new {{ .Target }}Request({{ range $i, $a := .RequestArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}));
        {{ .Var }}Response.EnsureSuccessStatusCode();
        var {{ .Var }} = await {{ .Var }}Response.Content.ReadFromJsonAsync<{{ .Target }}View>();
{{- end }}
{{- range .RelationTest.ManyToMany }}
        var {{ .Var }}Response = await client.PostAsJsonAsync("/api/{{ kebab $.Context }}/{{ kebab .Target }}", new {{ .Target }}Request({{ range $i, $a := .RequestArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}));
        {{ .Var }}Response.EnsureSuccessStatusCode();
        var {{ .Var }} = await {{ .Var }}Response.Content.ReadFromJsonAsync<{{ .Target }}View>();
        var {{ .SecondVar }}Response = await client.PostAsJsonAsync("/api/{{ kebab $.Context }}/{{ kebab .Target }}", new {{ .Target }}Request({{ range $i, $a := .RequestArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}));
        {{ .SecondVar }}Response.EnsureSuccessStatusCode();
        var {{ .SecondVar }} = await {{ .SecondVar }}Response.Content.ReadFromJsonAsync<{{ .Target }}View>();
{{- end }}
        var {{ $.RelationTest.Var }}Response = await client.PostAsJsonAsync("/api/{{ kebab $.Context }}/{{ kebab $.RelationTest.Aggregate }}", new {{ $.RelationTest.Aggregate }}Request({{ range $i, $a := $.RelationTest.CtorArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}));
        {{ $.RelationTest.Var }}Response.EnsureSuccessStatusCode();
        var {{ $.RelationTest.Var }} = await {{ $.RelationTest.Var }}Response.Content.ReadFromJsonAsync<{{ $.RelationTest.Aggregate }}View>();
{{- range .RelationTest.ManyToMany }}
        (await client.PostAsJsonAsync("/api/{{ kebab $.Context }}/{{ kebab .JoinEntity }}", new {{ .JoinEntity }}Request({{ $.RelationTest.Var }}.Id, {{ .Var }}.Id))).EnsureSuccessStatusCode();
        (await client.PostAsJsonAsync("/api/{{ kebab $.Context }}/{{ kebab .JoinEntity }}", new {{ .JoinEntity }}Request({{ $.RelationTest.Var }}.Id, {{ .SecondVar }}.Id))).EnsureSuccessStatusCode();
{{- end }}
{{- range .RelationTest.ManyToMany }}
        var {{ .Target }}Links = await client.GetFromJsonAsync<{{ .JoinEntity }}PagedResponse>($"/api/{{ kebab $.Context }}/{{ kebab .JoinEntity }}/search?{{ camel $.RelationTest.Aggregate }}Id={ {{ $.RelationTest.Var }}.Id }&page=1&pageSize=100");
        Assert.NotNull({{ .Target }}Links);
        Assert.Equal(2, {{ .Target }}Links!.Items.Count);
        Assert.Contains({{ .Target }}Links.Items, l => l.{{ .Target }}Id == {{ .Var }}.Id);
        Assert.Contains({{ .Target }}Links.Items, l => l.{{ .Target }}Id == {{ .SecondVar }}.Id);
{{- end }}
{{- range .RelationTest.Relations }}
        var {{ .Target }}Match = await client.GetFromJsonAsync<{{ $.RelationTest.Aggregate }}PagedResponse>($"/api/{{ kebab $.Context }}/{{ kebab $.RelationTest.Aggregate }}/search?{{ camel .Target }}Id={ {{ .Var }}.Id }&page=1&pageSize=100");
        Assert.NotNull({{ .Target }}Match);
        Assert.Single({{ .Target }}Match!.Items);
        Assert.Equal({{ .Var }}.Id, {{ .Target }}Match.Items[0].{{ .Target }}Id);
{{- if ne .DisplayProperty "Id" }}
        // nested relation search: filter the aggregate by the related entity's
        // display property (e.g. the customer's name).
        var {{ .Target }}NameMatch = await client.GetFromJsonAsync<{{ $.RelationTest.Aggregate }}PagedResponse>($"/api/{{ kebab $.Context }}/{{ kebab $.RelationTest.Aggregate }}/search?{{ camel .Target }}{{ .DisplayProperty }}Contains={Uri.EscapeDataString("Name sample")}&page=1&pageSize=100");
        Assert.NotNull({{ .Target }}NameMatch);
        Assert.Single({{ .Target }}NameMatch!.Items);
        Assert.Equal({{ $.RelationTest.Var }}.Id, {{ .Target }}NameMatch.Items[0].Id);
{{- end }}
{{- end }}
    }
}
