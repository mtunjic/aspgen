{{- range .RelationTest.Prereqs }}
            {{ .Var }} = (await new {{ .Target }}CrudService(dbFactory, new {{ .Target }}Validator()).CreateAsync(new {{ .Target }}Request({{ range $i, $a := .MvcArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}))).Id;
{{- end }}
{{- range .RelationTest.Relations }}
            {{ .Var }} = (await new {{ .Target }}CrudService(dbFactory, new {{ .Target }}Validator()).CreateAsync(new {{ .Target }}Request({{ range $i, $a := .MvcArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}))).Id;
{{- end }}
{{- range .RelationTest.ManyToMany }}
            {{ .Var }} = (await new {{ .Target }}CrudService(dbFactory, new {{ .Target }}Validator()).CreateAsync(new {{ .Target }}Request({{ range $i, $a := .MvcArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}))).Id;
            {{ .SecondVar }} = (await new {{ .Target }}CrudService(dbFactory, new {{ .Target }}Validator()).CreateAsync(new {{ .Target }}Request({{ range $i, $a := .MvcArgs }}{{ if $i }}, {{ end }}{{ $a }}{{ end }}))).Id;
{{- end }}
        }

        var form = new FormUrlEncodedContent(new[]
        {
{{- range .RelationTest.FormFields }}
            new KeyValuePair<string, string>("{{ .Name }}", {{ .Value }}),
{{- end }}
{{- range .RelationTest.ManyToMany }}
            new KeyValuePair<string, string>("selected{{ .Target }}Ids", {{ .Var }}.ToString()),
