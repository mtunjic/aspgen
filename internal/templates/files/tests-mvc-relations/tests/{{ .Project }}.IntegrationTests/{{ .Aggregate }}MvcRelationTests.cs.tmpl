        var index = await client.GetAsync("/{{ kebab .Context }}/{{ kebab .Aggregate }}");
        Assert.Equal(HttpStatusCode.OK, index.StatusCode);
        var indexBody = await index.Content.ReadAsStringAsync();
        Assert.Contains("{{ .Aggregate }}s", indexBody);
        Assert.Contains("bootstrap", indexBody);

        // The Create page (with the many-to-many multi-select) must render
        // without crashing and show no empty validation notice on a fresh GET.
        var createPage = await client.GetAsync("/{{ kebab .Context }}/{{ kebab .Aggregate }}/create");
        Assert.Equal(HttpStatusCode.OK, createPage.StatusCode);
        var createBody = await createPage.Content.ReadAsStringAsync();
        Assert.DoesNotContain("alert-danger", createBody);
{{- range .RelationTest.ManyToMany }}
        Assert.Contains("selected{{ .Target }}Ids", createBody);
{{- end }}

        // An invalid submission must surface the validation notice WITH its text.
{{- if .RelationTest.HasStringProp }}
