        Assert.DoesNotContain("No {{ $.Aggregate }}s found", await nestedHit.Content.ReadAsStringAsync());
        var nestedMiss = await client.GetAsync($"/{{ kebab $.Context }}/{{ kebab $.Aggregate }}?{{ camel .Target }}{{ .DisplayProperty }}Contains={Uri.EscapeDataString("no-such-name")}");
        Assert.Contains("No {{ $.Aggregate }}s found", await nestedMiss.Content.ReadAsStringAsync());
