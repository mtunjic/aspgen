{{- range .RelationTest.ManyToMany }}
            var {{ .Target }}Links = await db.{{ .JoinEntity }}s.Where(x => x.{{ $.RelationTest.Aggregate }}Id == aggregate.Id).ToListAsync();
            Assert.Equal(2, {{ .Target }}Links.Count);
            Assert.Contains({{ .Target }}Links, l => l.{{ .Target }}Id == {{ .Var }});
            Assert.Contains({{ .Target }}Links, l => l.{{ .Target }}Id == {{ .SecondVar }});
{{- end }}
        }

