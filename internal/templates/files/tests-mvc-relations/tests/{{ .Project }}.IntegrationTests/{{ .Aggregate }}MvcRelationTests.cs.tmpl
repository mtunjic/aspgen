        });
        var response = await client.PostAsync("/{{ kebab .Context }}/{{ kebab .Aggregate }}/create", form);
        Assert.Equal(HttpStatusCode.Redirect, response.StatusCode);

        // The list page must render end-to-end (layout + tag helpers + views),
