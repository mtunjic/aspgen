        var badResponse = await client.PostAsync("/{{ kebab .Context }}/{{ kebab .Aggregate }}/create", badForm);
        Assert.Equal(HttpStatusCode.OK, badResponse.StatusCode);
        var badBody = await badResponse.Content.ReadAsStringAsync();
        Assert.Contains("is required", badBody);
{{- end }}

        using (var scope = factory.Services.CreateScope())
