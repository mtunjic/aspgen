using System.ComponentModel.DataAnnotations;

namespace {{ .Project }}.DomainModel;

public class TimeStamp
{
    public TimeStamp() => When = DateTime.UtcNow;
    public DateTime? When { get; private set; }
    [MaxLength(50)] public string? By { get; private set; }
    public void Mark(string? author = null) { When = DateTime.UtcNow; if (!string.IsNullOrWhiteSpace(author)) By = author; }
}
