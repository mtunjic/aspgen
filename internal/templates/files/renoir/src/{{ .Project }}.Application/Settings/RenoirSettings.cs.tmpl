namespace {{ .Project }}.Application.Settings;

public sealed class RenoirSettings
{
    public const string AuthCookieName = "{{ .Project }}.Auth";
    public bool DevMode { get; set; } = true;
    public ProjectSettings Project { get; set; } = new();
    public SecretsSettings Secrets { get; set; } = new();
}

public sealed class ProjectSettings
{
    public string Name { get; set; } = "{{ .Project }}";
    public string Description { get; set; } = "";
    public string Version { get; set; } = "1.0.0";
}

public sealed class SecretsSettings
{
    public StorageDescriptor Database { get; set; } = new();
}

public sealed class StorageDescriptor
{
    public string Selector { get; set; } = "local";
    public string Live { get; set; } = "";
    public string Local { get; set; } = "Server=(localdb)\\mssqllocaldb;Database={{ .Project }};Trusted_Connection=True;TrustServerCertificate=True";
    public string Get() => Selector.Equals("live", StringComparison.OrdinalIgnoreCase) ? Live : Local;
}
