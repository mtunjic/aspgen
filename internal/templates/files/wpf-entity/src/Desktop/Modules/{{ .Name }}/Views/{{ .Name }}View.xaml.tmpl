<UserControl x:Class="{{ .Namespace }}.Views.{{ .Name }}View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"{{ if eq .Theme "wpfui" }}
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"{{ end }}
{{- if eq .Theme "wpfui" }}
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
{{- end }}
    prism:ViewModelLocator.AutoWireViewModel="True">
{{- if eq .Theme "wpfui" }}
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
{{- end }}
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ViewDetailsCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
{{- if eq .Theme "wpfui" }}
            <StackPanel DockPanel.Dock="Left">
                <ui:TextBlock FontTypography="TitleLarge" Text="{{ .Name }}" />
                <ui:TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontTypography="Body" Text="Manage {{ .Name }} records." />
            </StackPanel>
{{- else }}
            <TextBlock DockPanel.Dock="Left" FontSize="24" FontWeight="SemiBold" Text="{{ .Name }}" />
{{- end }}
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
{{- if eq .Theme "wpfui" }}
                <ui:ProgressRing Width="20" Height="20" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Margin="4,0,0,0" Padding="12,6" Appearance="Primary" Content="Add new {{ .Name }}" Icon="{ui:SymbolIcon Add24}" ToolTip="Create a new {{ .Name }}" Command="{Binding NewCommand}" />
                <ui:Button Margin="4,0,0,0" Padding="12,6" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise16}" ToolTip="Refresh {{ .Name }} records" Command="{Binding RefreshCommand}" />
{{- else }}
                <Button Margin="4,0,0,0" Padding="12,6" Content="Add new {{ .Name }}" Command="{Binding NewCommand}" />
                <Button Margin="4,0,0,0" Padding="12,6" Content="Refresh" ToolTip="Refresh {{ .Name }} records" Command="{Binding RefreshCommand}" />
{{- end }}
            </StackPanel>
        </DockPanel>

{{- if eq .Theme "wpfui" }}
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Content="Search" Icon="{ui:SymbolIcon Search24}" Command="{Binding SearchCommand}" />
            <ui:TextBox ClearButtonEnabled="True" PlaceholderText="Search {{ .Name }} records..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
{{- else }}
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6" Content="Search" Command="{Binding SearchCommand}" />
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
{{- end }}
        <Expander Grid.Row="2" Margin="0,0,0,8" Header="Advanced filters" IsExpanded="{Binding IsAdvancedFilterExpanded, Mode=TwoWay}">
            <StackPanel Margin="0,8,0,0">
                <WrapPanel>
{{- range .Properties }}
{{- if .RelationTarget }}
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{{ .DisplayName }}" />
                        <ComboBox Width="140" Margin="0,4,0,0" ItemsSource="{Binding {{ .RelationTarget }}Items}" DisplayMemberPath="{{ .RelationDisplayProperty }}" SelectedValuePath="Id" SelectedValue="{Binding Filter.{{ .Name }}, Mode=TwoWay}" />
                    </StackPanel>
{{- else if eq (filterKind .CSharpType) "string" }}
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{{ .DisplayName }} contains" />
                        <TextBox Width="160" Margin="0,4,0,0" Text="{Binding Filter.{{ .Name }}Contains, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
{{- else if eq (filterKind .CSharpType) "numeric" }}
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{{ .DisplayName }} min" />
                        <TextBox Width="90" Margin="0,4,0,0" Text="{Binding Filter.{{ .Name }}Min, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{{ .DisplayName }} max" />
                        <TextBox Width="90" Margin="0,4,0,0" Text="{Binding Filter.{{ .Name }}Max, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
{{- else if eq (filterKind .CSharpType) "date" }}
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{{ .DisplayName }} from" />
                        <DatePicker Width="130" Margin="0,4,0,0" SelectedDate="{Binding Filter.{{ .Name }}Min, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{{ .DisplayName }} to" />
                        <DatePicker Width="130" Margin="0,4,0,0" SelectedDate="{Binding Filter.{{ .Name }}Max, Mode=TwoWay}" />
                    </StackPanel>
{{- else if eq (filterKind .CSharpType) "bool" }}
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{{ .DisplayName }}" />
                        <ComboBox Width="90" Margin="0,4,0,0" SelectedValuePath="Content" SelectedValue="{Binding Filter.{{ .Name }}, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Null}" />
                            <ComboBoxItem Content="True" />
                            <ComboBoxItem Content="False" />
                        </ComboBox>
                    </StackPanel>
{{- end }}
{{- end }}
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
{{- if eq .Theme "wpfui" }}
                    <ui:Button Content="Apply" Command="{Binding SearchCommand}" />
                    <ui:Button Margin="8,0,0,0" Content="Clear" Command="{Binding ClearFiltersCommand}" />
{{- else }}
                    <Button Content="Apply" Command="{Binding SearchCommand}" />
                    <Button Margin="8,0,0,0" Content="Clear" Command="{Binding ClearFiltersCommand}" />
{{- end }}
                </StackPanel>
            </StackPanel>
        </Expander>
{{- if eq .Theme "wpfui" }}
        <ui:DataGrid Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" IsReadOnly="True" ItemsSource="{Binding Items}" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource ControlFillColorDefaultBrush}" SelectionMode="Single" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
{{- else }}
        <DataGrid Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" IsReadOnly="True" ItemsSource="{Binding Items}" AlternatingRowBackground="WhiteSmoke" SelectionMode="Single" SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
{{- end }}
            <DataGrid.Columns>
{{- range .Properties }}
{{- if .RelationTarget }}
                <DataGridTemplateColumn Header="{{ .DisplayName }}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Read-only lookup reusing the same ItemsSource/DisplayMemberPath/
                                 SelectedValuePath idiom as the edit-form and filter-panel pickers,
                                 so the grid shows the related record's name instead of its raw id. -->
                            <ComboBox IsHitTestVisible="False" Focusable="False" BorderThickness="0" Background="Transparent"
                                      ItemsSource="{Binding DataContext.{{ .RelationTarget }}Items, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      DisplayMemberPath="{{ .RelationDisplayProperty }}" SelectedValuePath="Id" SelectedValue="{Binding {{ .Name }}, Mode=OneWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
{{- else if eq .CSharpType "bool" }}
                <DataGridCheckBoxColumn Header="{{ .DisplayName }}" Binding="{Binding {{ .Name }}}" />
{{- else if or (eq .CSharpType "DateOnly") (eq .CSharpType "DateOnly?") }}
                <DataGridTextColumn Header="{{ .DisplayName }}" Binding="{Binding {{ .Name }}, StringFormat=d}" />
{{- else if or (eq .CSharpType "DateTime") (eq .CSharpType "DateTime?") }}
                <DataGridTextColumn Header="{{ .DisplayName }}" Binding="{Binding {{ .Name }}, StringFormat=g}" />
{{- else }}
                <DataGridTextColumn Header="{{ .DisplayName }}" Binding="{Binding {{ .Name }}}" />
{{- end }}
{{- end }}
            </DataGrid.Columns>
{{- if eq .Theme "wpfui" }}
        </ui:DataGrid>
{{- else }}
        </DataGrid>
{{- end }}
{{- if eq .Theme "wpfui" }}
        <ui:InfoBar Grid.Row="3" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsOpen="{Binding IsEmpty}" IsClosable="False" Severity="Informational" Title="No {{ .Name }} records" Message="Create a new {{ .Name }} to get started." />
{{- end }}
{{- if eq .Theme "wpfui" }}
        <DockPanel Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Center">
            <ui:Button Margin="0,0,8,0" Content="Prev" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding PrevPageCommand}" />
            <ui:TextBlock VerticalAlignment="Center" Text="{Binding PageLabel}" />
            <ui:Button Margin="8,0,0,0" Content="Next" Icon="{ui:SymbolIcon ArrowRight24}" Command="{Binding NextPageCommand}" />
        </DockPanel>
{{- else }}
        <DockPanel Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Center">
            <Button Margin="0,0,8,0" Padding="12,6" Content="Prev" Command="{Binding PrevPageCommand}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding PageLabel}" />
            <Button Margin="8,0,0,0" Padding="12,6" Content="Next" Command="{Binding NextPageCommand}" />
        </DockPanel>
{{- end }}
    </Grid>
</UserControl>

