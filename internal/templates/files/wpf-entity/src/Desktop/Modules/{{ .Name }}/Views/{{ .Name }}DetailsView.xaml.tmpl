<UserControl x:Class="{{ .Namespace }}.Views.{{ .Name }}DetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"{{ if eq .Theme "wpfui" }}
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"{{ end }}
{{- if eq .Theme "wpfui" }}
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
{{- end }}
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Header with separator -->
        <Border Grid.Row="0" Style="{StaticResource ListHeaderStyle}">
            <DockPanel LastChildFill="False">
{{- if eq .Theme "wpfui" }}
                <ui:TextBlock DockPanel.Dock="Left" FontTypography="TitleLarge" Text="{{ .Name }} details" />
                <ui:Button DockPanel.Dock="Right" Padding="12,6" Content="Back" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding BackCommand}" />
{{- else }}
                <TextBlock DockPanel.Dock="Left" FontSize="24" FontWeight="SemiBold" Text="{{ .Name }} details" />
                <Button DockPanel.Dock="Right" Padding="12,6" Content="Back" Command="{Binding BackCommand}" />
{{- end }}
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="680" HorizontalAlignment="Left" Style="{StaticResource CardStyle}">
                <StackPanel>
{{- range .Properties }}
                    <StackPanel Margin="0,8,0,0">
{{- if eq $.Theme "wpfui" }}
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{{ .DisplayName }}" />
{{- else }}
                        <TextBlock FontWeight="SemiBold" Text="{{ .DisplayName }}" />
{{- end }}
{{- if .RelationTarget }}
                        <TextBlock Text="{Binding {{ .RelationTarget }}.{{ .RelationDisplayProperty }}}" />
{{- else if or (eq .CSharpType "DateOnly") (eq .CSharpType "DateOnly?") }}
                        <TextBlock Text="{Binding Item.{{ .Name }}, StringFormat=d}" />
{{- else if or (eq .CSharpType "DateTime") (eq .CSharpType "DateTime?") }}
                        <TextBlock Text="{Binding Item.{{ .Name }}, StringFormat=g}" />
{{- else }}
                        <TextBlock Text="{Binding Item.{{ .Name }}}" />
{{- end }}
                    </StackPanel>
{{- end }}
{{- range .ManyToMany }}
                    <StackPanel Margin="0,8,0,0">
{{- if eq $.Theme "wpfui" }}
                        <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{{ .DisplayName }}" />
{{- else }}
                        <TextBlock FontWeight="SemiBold" Text="{{ .DisplayName }}" />
{{- end }}
                        <TextBlock Text="{Binding {{ .Name }}Display}" />
                    </StackPanel>
{{- end }}
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
