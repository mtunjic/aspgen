<UserControl x:Class="{{ .Namespace }}.Views.{{ .Name }}DetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:controls="clr-namespace:{{ .Project }}.Desktop.Shared.Controls"{{ if eq .Theme "wpfui" }}
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"{{ end }}
{{- if eq .Theme "wpfui" }}
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
{{- end }}
    prism:ViewModelLocator.AutoWireViewModel="True">
    <controls:DetailsPage>
        <controls:DetailsPage.FieldsContent>
            <StackPanel>
{{- range .Properties }}
                <StackPanel Margin="0,8,0,0">
{{- if eq $.Theme "wpfui" }}
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{{ .DisplayName }}" />
{{- else }}
                    <TextBlock FontWeight="SemiBold" Text="{{ .DisplayName }}" />
{{- end }}
{{- if .RelationTarget }}
                    <TextBlock Text="{Binding {{ .RelationTarget }}.{{ .RelationDisplayProperty }}}" />
{{- else if or (eq .CSharpType "DateOnly") (eq .CSharpType "DateOnly?") }}
                    <TextBlock Text="{Binding Item.{{ .Name }}, StringFormat=d}" />
{{- else if or (eq .CSharpType "DateTime") (eq .CSharpType "DateTime?") }}
                    <TextBlock Text="{Binding Item.{{ .Name }}, StringFormat=g}" />
{{- else }}
                    <TextBlock Text="{Binding Item.{{ .Name }}}" />
{{- end }}
                </StackPanel>
{{- end }}
{{- range .ManyToMany }}
                <StackPanel Margin="0,8,0,0">
{{- if eq $.Theme "wpfui" }}
                    <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{{ .DisplayName }}" />
{{- else }}
                    <TextBlock FontWeight="SemiBold" Text="{{ .DisplayName }}" />
{{- end }}
                    <TextBlock Text="{Binding {{ .Name }}Display}" />
                </StackPanel>
{{- end }}
            </StackPanel>
        </controls:DetailsPage.FieldsContent>
    </controls:DetailsPage>
</UserControl>
