{{- range .Relations }}{{- if index $.RelationQuickAdds .Target }}{{- $hasQuickAdd = true }}{{- end }}{{- end }}
{{- if $hasQuickAdd }}
    private bool justActivatedEdit;
{{- end }}

    public {{ .Name }}EditView() => InitializeComponent();
{{- range .Relations }}{{- if index $.RelationQuickAdds .Target }}

    // Clicking the relation dropdown flips it into editable mode so the user
    // can type a new related record and add it with the "+" button.
    private void Begin{{ .Target }}QuickAdd(object sender, MouseButtonEventArgs e)
    {
        if (DataContext is {{ $.Namespace }}.ViewModels.{{ $.Name }}EditViewModel viewModel)
        {
            if (!viewModel.Add{{ .Target }}Mode)
            {
                justActivatedEdit = true;
                viewModel.Begin{{ .Target }}QuickAdd();
            }
        }
    }

    // Keep the item list closed when the click only flips the combo into
    // editable mode, so typing isn't interrupted by the dropdown popping open.
    private void On{{ .Target }}DropDownOpened(object sender, System.EventArgs e)
    {
        if (justActivatedEdit)
        {
            justActivatedEdit = false;
            ((ComboBox)sender).IsDropDownOpen = false;
        }
    }

    // "+" commits whatever is typed in the editable combo as a new related
    // record. The combo is found as the sibling of the "+" button inside
    // their shared DockPanel -- it cannot carry an x:Name, because named
    // elements inside a UserControl's property content would conflict with
    // the control's own namescope (MC3093).
    private void OnAdd{{ .Target }}Click(object sender, RoutedEventArgs e)
    {
        if (DataContext is {{ $.Namespace }}.ViewModels.{{ $.Name }}EditViewModel viewModel
            && sender is FrameworkElement { Parent: DockPanel panel })
        {
            var combo = panel.Children.OfType<ComboBox>().FirstOrDefault();
            if (combo is not null && viewModel.Add{{ .Target }}(combo.Text))
            {
                combo.Text = string.Empty;
            }
        }
    }
{{- end }}{{- end }}
}
