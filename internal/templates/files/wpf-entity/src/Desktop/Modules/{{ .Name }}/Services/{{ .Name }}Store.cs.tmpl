public sealed class {{ .Name }}Store : I{{ .Name }}Store
{
    private readonly List<{{ .Name }}Row> items = [];
    private long nextId = 1;

    public IReadOnlyList<{{ .Name }}Row> GetAll() => items.ToArray();

    public {{ .Name }}PageResult Search({{ .Name }}SearchCriteria criteria)
    {
        var search = criteria.Search;
        var query = items.AsEnumerable();
{{- if hasQuickSearchField .Properties }}
        if (!string.IsNullOrWhiteSpace(search)) query = query.Where(x => {{ quickSearchExpr .Properties "x" }});
{{- end }}
        {{ filterWhereClauses .Properties "x" "criteria." }}
        var filtered = query.ToList();
        var paged = filtered.Skip((criteria.Page - 1) * criteria.PageSize).Take(criteria.PageSize).ToList();
        return new {{ .Name }}PageResult(paged, filtered.Count, criteria.Page, criteria.PageSize);
    }

    public {{ .Name }}Row Save(long editingId, {{ .Name }}Row value)
    {
        if (editingId == 0)
        {
            value = value with { Id = nextId++ };
            items.Add(value);
            return value;
        }

        var index = items.FindIndex(x => x.Id == editingId);
        if (index < 0) return value;
        items[index] = value with { Id = editingId };
        return items[index];
    }

    public void Delete(long id)
    {
        items.RemoveAll(x => x.Id == id);
    }
}
