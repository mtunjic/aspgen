public sealed class {{ .Name }}Store(HttpClient http) : I{{ .Name }}Store
{
{{- if .Context }}
    private const string Path = "/api/{{ kebab .Context }}/{{ kebab .Name }}";
{{- else }}
    private const string Path = "/api/{{ kebab .Name }}";
{{- end }}

    // Task.Run(...) offloads the async call onto a thread-pool thread with no
    // SynchronizationContext, so its await continuations never need to marshal
    // back to the (blocked) calling thread -- calling .GetAwaiter().GetResult()
    // directly here would deadlock on the WPF UI thread instead.
    public IReadOnlyList<{{ .Name }}Row> GetAll() =>
        Task.Run(() => http.GetFromJsonAsync<List<{{ .Name }}Row>>(Path)).GetAwaiter().GetResult() ?? [];

    public {{ .Name }}PageResult Search({{ .Name }}SearchCriteria criteria)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(criteria.Search)) query.Add($"search={Uri.EscapeDataString(criteria.Search)}");
{{- range .Properties }}
{{- if .RelationTarget }}
        if (criteria.{{ .Name }}.HasValue) query.Add($"{{ camel .Name }}={criteria.{{ .Name }}.Value}");
{{- else if eq (filterKind .CSharpType) "string" }}
        if (!string.IsNullOrWhiteSpace(criteria.{{ .Name }}Contains)) query.Add($"{{ camel .Name }}Contains={Uri.EscapeDataString(criteria.{{ .Name }}Contains)}");
{{- else if eq (filterKind .CSharpType) "numeric" }}
        if (criteria.{{ .Name }}Min.HasValue) query.Add($"{{ camel .Name }}Min={criteria.{{ .Name }}Min.Value}");
        if (criteria.{{ .Name }}Max.HasValue) query.Add($"{{ camel .Name }}Max={criteria.{{ .Name }}Max.Value}");
{{- else if eq (filterKind .CSharpType) "date" }}
        if (criteria.{{ .Name }}Min.HasValue) query.Add($"{{ camel .Name }}Min={criteria.{{ .Name }}Min.Value:O}");
        if (criteria.{{ .Name }}Max.HasValue) query.Add($"{{ camel .Name }}Max={criteria.{{ .Name }}Max.Value:O}");
{{- else if eq (filterKind .CSharpType) "bool" }}
        if (criteria.{{ .Name }}.HasValue) query.Add($"{{ camel .Name }}={criteria.{{ .Name }}.Value}");
{{- end }}
{{- end }}
{{- range .Properties }}{{- if ne (relationNestedFilterField .) "" }}
        if (!string.IsNullOrWhiteSpace(criteria.{{ relationNestedFilterField . }})) query.Add($"{{ camel (relationNestedFilterField .) }}={Uri.EscapeDataString(criteria.{{ relationNestedFilterField . }})}");
{{- end }}{{- end }}
        query.Add($"page={criteria.Page}");
        query.Add($"pageSize={criteria.PageSize}");
        var url = $"{Path}/search?{string.Join("&", query)}";
        var result = Task.Run(() => http.GetFromJsonAsync<{{ .Name }}PageResult>(url)).GetAwaiter().GetResult();
        return result ?? new {{ .Name }}PageResult([], 0, criteria.Page, criteria.PageSize);
    }
    public {{ .Name }}Row Save(long editingId, {{ .Name }}Row value)
    {
        if (editingId == 0)
        {
            var response = Task.Run(() => http.PostAsJsonAsync(Path, value)).GetAwaiter().GetResult();
            response.EnsureSuccessStatusCode();
            return Task.Run(() => response.Content.ReadFromJsonAsync<{{ .Name }}Row>()).GetAwaiter().GetResult() ?? value;
        }

        var update = Task.Run(() => http.PutAsJsonAsync($"{Path}/{editingId}", value)).GetAwaiter().GetResult();
        update.EnsureSuccessStatusCode();
        return value with { Id = editingId };
    }

    public void Delete(long id)
    {
        var response = Task.Run(() => http.DeleteAsync($"{Path}/{id}")).GetAwaiter().GetResult();
        response.EnsureSuccessStatusCode();
    }
}
