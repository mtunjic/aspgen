using Prism.Ioc;
using Prism.Modularity;
using Prism.Navigation.Regions;
{{- if eq .Backend "ddd-local" }}
using Microsoft.EntityFrameworkCore;
using {{ .Project }}.Infrastructure.Persistence;
{{- if eq .Seed "dummy" }}
using {{ .Project }}.Infrastructure.Seeding;
{{- end }}
{{- end }}
{{- if eq .Backend "dm" }}
using FluentValidation;
using Microsoft.EntityFrameworkCore;
using {{ .Project }}.Application;
using {{ .Project }}.Persistence;
{{- end }}
{{- if or (eq .Backend "simple") (eq .Backend "ddd") (eq .Backend "cqrs") (eq .Backend "es") }}
using System.Net.Http;
{{- end }}
{{- if eq .Theme "wpfui" }}
using {{ .Project }}.Desktop.Navigation;
using Wpf.Ui.Controls;
{{- end }}

namespace {{ .Namespace }};

public sealed class {{ .Name }}Module : IModule
{
    public void RegisterTypes(IContainerRegistry containerRegistry)
    {
{{- if or (eq .Backend "simple") (eq .Backend "ddd") (eq .Backend "cqrs") (eq .Backend "es") }}
        var apiUrl = Environment.GetEnvironmentVariable("ASPGENT_API_URL") ?? "http://localhost:5000";
        containerRegistry.RegisterSingleton<HttpClient>(() => new HttpClient { BaseAddress = new Uri(apiUrl) });
{{- end }}
{{- if eq .Backend "ddd-local" }}
        containerRegistry.RegisterSingleton<AppDbContext>(() =>
        {
            var options = new DbContextOptionsBuilder<AppDbContext>()
                .UseSqlite("Data Source={{ .Project }}.db")
                .Options;
            var db = new AppDbContext(options);
            db.Database.EnsureCreated();
{{- if eq .Seed "dummy" }}
            DatabaseSeeder.Seed(db);
{{- end }}
            return db;
        });
{{- end }}
{{- if eq .Backend "dm" }}
        containerRegistry.RegisterSingleton<{{ .Project }}Database>(() =>
        {
            // Must match the exact "Data Source={{.Project}}.db" fallback connection
            // string cqrs/es's own Infrastructure/DependencyInjection.cs.tmpl uses for
            // the SAME shared {{ .Project }}Database in a mixed dm+cqrs solution -- a
            // kebab-cased filename here would silently point this module at a second,
            // completely separate (and empty) SQLite file instead of the one the WebApi
            // host (and any data seeded into it) actually uses.
            var options = new DbContextOptionsBuilder<{{ .Project }}Database>()
                .UseSqlite("Data Source={{ .Project }}.db")
                .Options;
            var db = new {{ .Project }}Database(options);
            db.Database.EnsureCreated();
            return db;
        });
        containerRegistry.Register<IValidator<{{ .Name }}Request>, {{ .Name }}Validator>();
        containerRegistry.RegisterSingleton<{{ .Name }}CrudService>();
{{- end }}
        containerRegistry.RegisterSingleton<Services.I{{ .Name }}Store, Services.{{ .Name }}Store>();
        containerRegistry.RegisterForNavigation<Views.{{ .Name }}View>();
        containerRegistry.RegisterForNavigation<Views.{{ .Name }}DetailsView>("{{ .Name }}DetailsView");
    }

    public void OnInitialized(IContainerProvider containerProvider)
    {
{{- if ne .Theme "wpfui" }}
        var regionManager = containerProvider.Resolve<IRegionManager>();
{{- end }}
{{- if eq .Theme "wpfui" }}
        var navigation = containerProvider.Resolve<NavigationRegistry>();
        navigation.Register("{{ .Name }}", "{{ .Name }}View", SymbolRegular.Table24);
{{- else }}
        regionManager.RegisterViewWithRegion("MenuRegion", typeof(Views.{{ .Name }}MenuView));
{{- end }}
    }
}
