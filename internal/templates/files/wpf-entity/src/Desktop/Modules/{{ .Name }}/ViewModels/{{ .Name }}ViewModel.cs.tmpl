    {
{{- range .Properties }}
{{- if .RelationTarget }}
        {{ .Name }} = string.Empty;
{{- else if eq (filterKind .CSharpType) "string" }}
        {{ .Name }}Contains = string.Empty;
{{- else if eq (filterKind .CSharpType) "numeric" }}
        {{ .Name }}Min = string.Empty;
        {{ .Name }}Max = string.Empty;
{{- else if eq (filterKind .CSharpType) "date" }}
        {{ .Name }}Min = null;
        {{ .Name }}Max = null;
{{- else if eq (filterKind .CSharpType) "bool" }}
        {{ .Name }} = null;
{{- end }}
{{- end }}
    }
}
