    private void Reload()
    {
        Items.Clear();
        foreach (var item in store.GetAll()) Items.Add(item);
        RaisePropertyChanged(nameof(IsEmpty));
    }

    private void Refresh()
    {
        SelectedItem = null;
        Reload();
        OperationMessage = string.Empty;
    }

    private void New()
    {
        editingId = 0;
        Form.Reset(null);
        ValidationMessage = string.Empty;
        OperationMessage = string.Empty;
        RaisePropertyChanged(nameof(IsEditing));
    }

    private void Edit()
    {
        if (SelectedItem is null) return;
        editingId = SelectedItem.Id;
        Form.Reset(SelectedItem);
        ValidationMessage = string.Empty;
        OperationMessage = string.Empty;
        RaisePropertyChanged(nameof(IsEditing));
    }

    private void Save()
    {
        if (!TryBuild(out var value)) return;
        var operation = editingId == 0 ? "created" : "updated";
        store.Save(editingId, value);
        SelectedItem = null;
        editingId = 0;
        Form.Reset(null);
        ValidationMessage = string.Empty;
        OperationMessage = $"{{ .Name }} {operation} successfully.";
        Reload();
        RaisePropertyChanged(nameof(IsEditing));
    }

    private void Delete()
    {
        if (SelectedItem is null) return;
        store.Delete(SelectedItem.Id);
        SelectedItem = null;
        OperationMessage = "{{ .Name }} deleted successfully.";
        Reload();
    }

    private void Cancel()
    {
        editingId = 0;
        SelectedItem = null;
        Form.Reset(null);
        ValidationMessage = string.Empty;
        OperationMessage = string.Empty;
        RaisePropertyChanged(nameof(IsEditing));
    }

