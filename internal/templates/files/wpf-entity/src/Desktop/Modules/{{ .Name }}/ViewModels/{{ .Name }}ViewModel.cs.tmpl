using System.Collections.ObjectModel;
{{- if eq .Theme "wpfui" }}
using Wpf.Ui;
{{- end }}
using Prism.Commands;
using Prism.Mvvm;
using Prism.Navigation.Regions;
using {{ .Namespace }}.Models;
using {{ .Namespace }}.Services;
{{- range .Relations }}
using {{ $.Project }}.Desktop.Modules.{{ .Target }}.Services;
using {{ $.Project }}.Desktop.Modules.{{ .Target }}.Models;
{{- end }}
// aspgen:relatedUsings

namespace {{ .Namespace }}.ViewModels;

public sealed class {{ .Name }}ViewModel : BindableBase
{
    private const int PageSize = 25;
    private readonly I{{ .Name }}Store store;
    private readonly IRegionManager regionManager;
{{- range .Relations }}
    private readonly I{{ .Target }}Store {{ camel .Target }}Store;
{{- end }}
    // aspgen:relatedStores
    private {{ .Name }}Row? selectedItem;
    private bool isBusy;
    private string searchText = string.Empty;
    private bool isAdvancedFilterExpanded;
    private int page = 1;
    private long totalCount;

    public {{ .Name }}ViewModel(I{{ .Name }}Store store, IRegionManager regionManager{{ range .Relations }}, I{{ .Target }}Store {{ camel .Target }}Store{{ end }}/* aspgen:relatedParams */)
    {
        this.store = store;
        this.regionManager = regionManager;
{{- range .Relations }}
        this.{{ camel .Target }}Store = {{ camel .Target }}Store;
{{- end }}
        // aspgen:relatedAssignments
        Filter = new {{ .Name }}FilterEditor();
        NewCommand = new DelegateCommand(New, () => !IsBusy);
        RefreshCommand = new DelegateCommand(Refresh, () => !IsBusy);
        SearchCommand = new DelegateCommand(Search, () => !IsBusy);
        PrevPageCommand = new DelegateCommand(PrevPage, () => !IsBusy && Page > 1);
        NextPageCommand = new DelegateCommand(NextPage, () => !IsBusy && Page < TotalPages);
        ClearFiltersCommand = new DelegateCommand(ClearFilters, () => !IsBusy);
        ViewDetailsCommand = new DelegateCommand(ViewDetails, () => SelectedItem is not null);
        LoadRelated();
        Search();
    }

    public ObservableCollection<{{ .Name }}Row> Items { get; } = [];
{{- range .Relations }}
    public ObservableCollection<{{ .Target }}Row> {{ .Target }}Items { get; } = [];
{{- end }}
    // aspgen:relatedCollections
    public {{ .Name }}FilterEditor Filter { get; }
    public bool IsEmpty => Items.Count == 0;
    public string SearchText
    {
        get => searchText;
        set => SetProperty(ref searchText, value);
    }
    public bool IsAdvancedFilterExpanded
    {
        get => isAdvancedFilterExpanded;
        set => SetProperty(ref isAdvancedFilterExpanded, value);
    }
    public int Page
    {
        get => page;
        private set
        {
            if (SetProperty(ref page, value))
            {
                RaisePropertyChanged(nameof(PageLabel));
                PrevPageCommand.RaiseCanExecuteChanged();
                NextPageCommand.RaiseCanExecuteChanged();
            }
        }
    }
    public long TotalCount
    {
        get => totalCount;
        private set
        {
            if (SetProperty(ref totalCount, value))
            {
                RaisePropertyChanged(nameof(TotalPages));
                RaisePropertyChanged(nameof(PageLabel));
                PrevPageCommand.RaiseCanExecuteChanged();
                NextPageCommand.RaiseCanExecuteChanged();
            }
        }
    }
    public int TotalPages => (int)Math.Max(1, Math.Ceiling(TotalCount / (double)PageSize));
    public string PageLabel => $"Page {Page} of {TotalPages}";
    public bool IsBusy
    {
        get => isBusy;
        private set
        {
            if (SetProperty(ref isBusy, value))
            {
                NewCommand.RaiseCanExecuteChanged();
                RefreshCommand.RaiseCanExecuteChanged();
                SearchCommand.RaiseCanExecuteChanged();
                PrevPageCommand.RaiseCanExecuteChanged();
                NextPageCommand.RaiseCanExecuteChanged();
                ClearFiltersCommand.RaiseCanExecuteChanged();
            }
        }
    }

    public {{ .Name }}Row? SelectedItem
    {
        get => selectedItem;
        set
        {
            if (SetProperty(ref selectedItem, value))
            {
                ViewDetailsCommand.RaiseCanExecuteChanged();
            }
        }
    }

    public DelegateCommand NewCommand { get; }
    public DelegateCommand RefreshCommand { get; }
    public DelegateCommand SearchCommand { get; }
    public DelegateCommand PrevPageCommand { get; }
    public DelegateCommand NextPageCommand { get; }
    public DelegateCommand ClearFiltersCommand { get; }
    public DelegateCommand ViewDetailsCommand { get; }

    private void LoadRelated()
    {
{{- range .Relations }}
        {{ .Target }}Items.Clear();
        foreach (var item in {{ camel .Target }}Store.GetAll()) {{ .Target }}Items.Add(item);
{{- end }}
        // aspgen:relatedLoads
    }

    private void Refresh()
    {
        SelectedItem = null;
        Search();
    }

    private void ExecuteSearch()
    {
        IsBusy = true;
        try
        {
            var result = store.Search(BuildCriteria(Page));
            Items.Clear();
            foreach (var item in result.Items) Items.Add(item);
            TotalCount = result.TotalCount;
            RaisePropertyChanged(nameof(IsEmpty));
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void Search()
    {
        Page = 1;
        ExecuteSearch();
    }

    private void PrevPage()
    {
        Page--;
        ExecuteSearch();
    }

    private void NextPage()
    {
        Page++;
        ExecuteSearch();
    }

    private void ClearFilters()
    {
        SearchText = string.Empty;
        Filter.Clear();
        Search();
    }

    private void New()
    {
        regionManager.RequestNavigate("MainRegion", "{{ .Name }}EditView");
    }

    private void ViewDetails()
    {
        if (SelectedItem is null) return;
        var parameters = new NavigationParameters { { "id", SelectedItem.Id } };
        regionManager.RequestNavigate("MainRegion", "{{ .Name }}DetailsView", parameters);
    }

    private {{ .Name }}SearchCriteria BuildCriteria(int page)
    {
{{- range .Properties }}
{{- if .RelationTarget }}
        long? {{ camel .Name }} = long.TryParse(Filter.{{ .Name }}, out var parsed{{ .Name }}) ? parsed{{ .Name }} : null;
{{- else if eq (filterKind .CSharpType) "string" }}
        var {{ camel .Name }}Contains = string.IsNullOrWhiteSpace(Filter.{{ .Name }}Contains) ? null : Filter.{{ .Name }}Contains;
{{- else if eq (filterKind .CSharpType) "numeric" }}
        {{ trimSuffix .CSharpType "?" }}? {{ camel .Name }}Min = {{ trimSuffix .CSharpType "?" }}.TryParse(Filter.{{ .Name }}Min, out var parsed{{ .Name }}Min) ? parsed{{ .Name }}Min : null;
        {{ trimSuffix .CSharpType "?" }}? {{ camel .Name }}Max = {{ trimSuffix .CSharpType "?" }}.TryParse(Filter.{{ .Name }}Max, out var parsed{{ .Name }}Max) ? parsed{{ .Name }}Max : null;
{{- else if eq (filterKind .CSharpType) "date" }}
{{- if or (eq .CSharpType "DateOnly") (eq .CSharpType "DateOnly?") }}
        DateOnly? {{ camel .Name }}Min = Filter.{{ .Name }}Min is null ? null : DateOnly.FromDateTime(Filter.{{ .Name }}Min.Value);
        DateOnly? {{ camel .Name }}Max = Filter.{{ .Name }}Max is null ? null : DateOnly.FromDateTime(Filter.{{ .Name }}Max.Value);
{{- else }}
        DateTime? {{ camel .Name }}Min = Filter.{{ .Name }}Min;
        DateTime? {{ camel .Name }}Max = Filter.{{ .Name }}Max;
{{- end }}
{{- else if eq (filterKind .CSharpType) "bool" }}
        var {{ camel .Name }} = Filter.{{ .Name }};
{{- end }}
{{- end }}
        return new {{ .Name }}SearchCriteria(string.IsNullOrWhiteSpace(SearchText) ? null : SearchText{{ filterParamNames .Properties "" "camel" }}, page, PageSize);
    }
}

