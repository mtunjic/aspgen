<UserControl x:Class="{{ .Namespace }}.Views.{{ .Name }}EditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"{{ if eq .Theme "wpfui" }}
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"{{ end }}
{{- if eq .Theme "wpfui" }}
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
{{- end }}
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header band with accent background + separator -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBandStyle}">
{{- if eq .Theme "wpfui" }}
            <ui:TextBlock FontTypography="TitleLarge" Text="{Binding Title}" />
{{- else }}
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="{Binding Title}" />
{{- end }}
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Details section: fields flow into a responsive grid -->
                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <StackPanel>
{{- if eq $.Theme "wpfui" }}
                        <ui:TextBlock Style="{StaticResource SectionHeaderStyle}" Text="DETAILS" />
{{- else }}
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="DETAILS" />
{{- end }}
                        <WrapPanel>
{{- range .Properties }}
                            <StackPanel Width="{{ if or (eq .CSharpType "DateTime") (eq .CSharpType "DateTime?") }}480{{ else }}320{{ end }}" Margin="0,0,16,14">
{{- if eq $.Theme "wpfui" }}
                                <ui:TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{{ .DisplayName }}" />
{{- else }}
                                <TextBlock Text="{{ .DisplayName }}" />
{{- end }}
{{- if .RelationTarget }}
{{- if index $.RelationQuickAdds .RelationTarget }}
                            <DockPanel Margin="0,4,0,0">
{{- if eq $.Theme "wpfui" }}
                                <ui:Button DockPanel.Dock="Right" Width="34" Height="30" Margin="6,0,0,0" Padding="0" Appearance="Secondary" Content="+" ToolTip="Add new {{ .RelationTarget }} right here" Click="OnAdd{{ .RelationTarget }}Click" />
                                <ComboBox x:Name="{{ camel .RelationTarget }}Combo" PreviewMouseLeftButtonDown="Begin{{ .RelationTarget }}QuickAdd" DropDownOpened="On{{ .RelationTarget }}DropDownOpened"
                                          IsEditable="{Binding Add{{ .RelationTarget }}Mode, Mode=TwoWay}"
                                          ItemsSource="{Binding {{ .RelationTarget }}Items}" DisplayMemberPath="{{ .RelationDisplayProperty }}" SelectedValuePath="Id" SelectedValue="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
{{- else }}
                                <Button DockPanel.Dock="Right" Width="34" Height="30" Margin="6,0,0,0" Padding="0" FontWeight="Bold" Content="+" ToolTip="Add new {{ .RelationTarget }} right here" Click="OnAdd{{ .RelationTarget }}Click" />
                                <ComboBox x:Name="{{ camel .RelationTarget }}Combo" PreviewMouseLeftButtonDown="Begin{{ .RelationTarget }}QuickAdd" DropDownOpened="On{{ .RelationTarget }}DropDownOpened"
                                          IsEditable="{Binding Add{{ .RelationTarget }}Mode, Mode=TwoWay}"
                                          ItemsSource="{Binding {{ .RelationTarget }}Items}" DisplayMemberPath="{{ .RelationDisplayProperty }}" SelectedValuePath="Id" SelectedValue="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
{{- end }}
                            </DockPanel>
{{- else }}
                            <ComboBox Margin="0,4,0,0" ItemsSource="{Binding {{ .RelationTarget }}Items}" DisplayMemberPath="{{ .RelationDisplayProperty }}" SelectedValuePath="Id" SelectedValue="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
{{- end }}
{{- else if or (eq .CSharpType "DateOnly") (eq .CSharpType "DateOnly?") }}
{{- if eq $.Theme "wpfui" }}
                                <ui:CalendarDatePicker Margin="0,4,0,0" Date="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
{{- else }}
                                <DatePicker Margin="0,4,0,0" SelectedDate="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
{{- end }}
{{- else if or (eq .CSharpType "DateTime") (eq .CSharpType "DateTime?") }}
{{- if eq $.Theme "wpfui" }}
                                <StackPanel Orientation="Horizontal">
                                    <ui:CalendarDatePicker Width="280" Margin="0,4,8,0" Date="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
                                    <ui:TimePicker Width="160" Margin="0,4,0,0" SelectedTime="{Binding Form.{{ .Name }}Time, Mode=TwoWay}" />
                                </StackPanel>
{{- else }}
                                <DatePicker Margin="0,4,0,0" SelectedDate="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
{{- end }}
{{- else if eq .CSharpType "bool" }}
{{- if eq $.Theme "wpfui" }}
                                <ui:ToggleSwitch Margin="0,6,0,0" IsChecked="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
{{- else }}
                                <CheckBox Margin="0,4,0,0" IsChecked="{Binding Form.{{ .Name }}, Mode=TwoWay}" />
{{- end }}
{{- else if or (eq .CSharpType "int") (eq .CSharpType "int?") (eq .CSharpType "long") (eq .CSharpType "long?") (eq .CSharpType "decimal") (eq .CSharpType "decimal?") (eq .CSharpType "float") (eq .CSharpType "float?") }}
{{- if eq $.Theme "wpfui" }}
                                <ui:NumberBox Margin="0,4,0,0" ClearButtonEnabled="True" PlaceholderText="{{ .DisplayName }}" Text="{Binding Form.{{ .Name }}, UpdateSourceTrigger=PropertyChanged}" />
{{- else }}
                                <TextBox Margin="0,4,0,0" Text="{Binding Form.{{ .Name }}, UpdateSourceTrigger=PropertyChanged}" />
{{- end }}
{{- else }}
{{- if eq $.Theme "wpfui" }}
                                <ui:TextBox Margin="0,4,0,0" ClearButtonEnabled="True" PlaceholderText="{{ .DisplayName }}" Text="{Binding Form.{{ .Name }}, UpdateSourceTrigger=PropertyChanged}" />
{{- else }}
                                <TextBox Margin="0,4,0,0" Text="{Binding Form.{{ .Name }}, UpdateSourceTrigger=PropertyChanged}" />
{{- end }}
{{- end }}
                            </StackPanel>
{{- end }}
                        </WrapPanel>
                    </StackPanel>
                </Border>
{{- range .ManyToMany }}
                <!-- {{ .DisplayName }} section -->
                <Border Margin="0,0,0,14" Style="{StaticResource CardSecondaryStyle}">
                    <StackPanel>
{{- if eq $.Theme "wpfui" }}
                        <ui:TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{{ .DisplayName }}" />
{{- else }}
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{{ .DisplayName }}" />
{{- end }}
                        <ItemsControl ItemsSource="{Binding {{ .Target }}Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,3,0,0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
{{- end }}
{{- if eq .Theme "wpfui" }}
                <ui:InfoBar Margin="0,0,0,12" IsOpen="{Binding HasValidationError}" IsClosable="False" Severity="Error" Title="Validation" Message="{Binding ValidationMessage}" />
{{- else }}
                <TextBlock Margin="0,0,0,12" Foreground="Firebrick" Text="{Binding ValidationMessage}" />
{{- end }}
            </StackPanel>
        </ScrollViewer>

        <!-- Action footer -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0" BorderThickness="0,1,0,0"
{{- if eq .Theme "wpfui" }}
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
{{- else }}
                BorderBrush="#E2E8F0">
{{- end }}
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
{{- if eq .Theme "wpfui" }}
                <ui:Button Padding="14,7" Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Save24}" ToolTip="Save changes" Command="{Binding SaveCommand}" />
                <ui:Button Margin="8,0,0,0" Padding="12,6" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Cancel editing" Command="{Binding CancelCommand}" />
{{- else }}
                <Button Padding="12,6" FontWeight="SemiBold" Content="Save" Command="{Binding SaveCommand}" />
                <Button Margin="8,0,0,0" Padding="12,6" Content="Cancel" Command="{Binding CancelCommand}" />
{{- end }}
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
