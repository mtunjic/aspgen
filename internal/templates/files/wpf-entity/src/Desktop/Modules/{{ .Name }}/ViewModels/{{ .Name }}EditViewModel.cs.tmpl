        var {{ camel .Name }} = DateOnly.FromDateTime(Form.{{ .Name }}.Value);
{{- else if eq .CSharpType "DateTime" }}
        if (Form.{{ .Name }} is null) return Invalid(nameof(Form.{{ .Name }}));
        if (Form.{{ .Name }}Time is null) return Invalid(nameof(Form.{{ .Name }}));
        var {{ camel .Name }} = DateTime.SpecifyKind(Form.{{ .Name }}.Value.Date + Form.{{ .Name }}Time.Value, DateTimeKind.Unspecified);
{{- else if or (eq .CSharpType "int") (eq .CSharpType "long") (eq .CSharpType "decimal") (eq .CSharpType "float") (eq .CSharpType "Guid") }}
        if (!{{ .CSharpType }}.TryParse(Form.{{ .Name }}, out var {{ camel .Name }})) return Invalid(nameof(Form.{{ .Name }}));
{{- else if eq .CSharpType "DateOnly?" }}
        DateOnly? {{ camel .Name }} = Form.{{ .Name }} is null ? null : DateOnly.FromDateTime(Form.{{ .Name }}.Value);
{{- else if eq .CSharpType "DateTime?" }}
        DateTime? {{ camel .Name }} = Form.{{ .Name }} is null || Form.{{ .Name }}Time is null ? null : DateTime.SpecifyKind(Form.{{ .Name }}.Value.Date + Form.{{ .Name }}Time.Value, DateTimeKind.Unspecified);
{{- else if or (eq .CSharpType "int?") (eq .CSharpType "long?") (eq .CSharpType "decimal?") (eq .CSharpType "float?") (eq .CSharpType "Guid?") }}
        {{ .CSharpType }} {{ camel .Name }} = null;
        if (!string.IsNullOrWhiteSpace(Form.{{ .Name }}))
        {
            if (!{{ trimSuffix .CSharpType "?" }}.TryParse(Form.{{ .Name }}, out var parsed{{ .Name }})) return Invalid(nameof(Form.{{ .Name }}));
            {{ camel .Name }} = parsed{{ .Name }};
        }
{{- end }}
{{- end }}
        value = new {{ .Name }}Row(editingId{{ range .Properties }}, {{ camel .Name }}{{ end }});
        return true;
    }
}

