        var {{ camel .Name }} = string.IsNullOrWhiteSpace(Form.{{ .Name }}) ? null : Form.{{ .Name }}!.Trim();
{{- else if eq .CSharpType "bool" }}
        var {{ camel .Name }} = Form.{{ .Name }};
