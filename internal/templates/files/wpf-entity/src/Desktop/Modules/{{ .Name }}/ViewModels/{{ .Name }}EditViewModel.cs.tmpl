        if (!TryBuild(out var value)) return;
        IsBusy = true;
        try
        {
            var operation = editingId == 0 ? "created" : "updated";
            var saved = store.Save(editingId, value);
{{- if eq .Theme "wpfui" }}
            snackbarService.Show("Saved", $"{{ .Name }} {operation} successfully.", ControlAppearance.Success, new SymbolIcon { Symbol = SymbolRegular.CheckmarkCircle24 }, TimeSpan.FromSeconds(4));
{{- end }}
            var parameters = new NavigationParameters { { "id", saved.Id } };
            regionManager.RequestNavigate("MainRegion", "{{ .Name }}DetailsView", parameters);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void Cancel()
    {
        if (IsEditing)
        {
            var parameters = new NavigationParameters { { "id", editingId } };
            regionManager.RequestNavigate("MainRegion", "{{ .Name }}DetailsView", parameters);
        }
        else
        {
            regionManager.RequestNavigate("MainRegion", "{{ .Name }}View");
        }
    }

