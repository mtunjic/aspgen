using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Infrastructure;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using {{ .Project }}.Persistence;

namespace {{ .Project }}.Infrastructure;

public static class DependencyInjection
{
    public static IServiceCollection AddInfrastructure(this IServiceCollection services, IConfiguration configuration)
    {
        var connectionString = configuration.GetConnectionString("DefaultConnection")
{{- if eq .Database "postgres" }}
            ?? "Host=localhost;Database={{ kebab .Project }};Username=postgres;Password=postgres";
        services.AddDbContext<{{ .Project }}Database>(options => options.UseNpgsql(connectionString));
        // CrudServices create a fresh pooled DbContext per operation via this
        // singleton factory. It builds its OWN options (independent of the
        // scoped AddDbContext registration above) so the singleton does not
        // depend on a scoped service.
        services.AddSingleton<IDbContextFactory<{{ .Project }}Database>>(_ =>
            new PooledDbContextFactory<{{ .Project }}Database>(
                new DbContextOptionsBuilder<{{ .Project }}Database>().UseNpgsql(connectionString).Options));
{{- else }}
            ?? "Data Source={{ .Project }}.db";
        services.AddDbContext<{{ .Project }}Database>(options => options.UseSqlite(connectionString));
        // CrudServices create a fresh pooled DbContext per operation via this
        // singleton factory. It builds its OWN options (independent of the
        // scoped AddDbContext registration above) so the singleton does not
        // depend on a scoped service.
        services.AddSingleton<IDbContextFactory<{{ .Project }}Database>>(_ =>
            new PooledDbContextFactory<{{ .Project }}Database>(
                new DbContextOptionsBuilder<{{ .Project }}Database>().UseSqlite(connectionString).Options));
{{- end }}
        // aspgen:repositories
        services.AddHealthChecks().AddDbContextCheck<{{ .Project }}Database>();
        return services;
    }
}
