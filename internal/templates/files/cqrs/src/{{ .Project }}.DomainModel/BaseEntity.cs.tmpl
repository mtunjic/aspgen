namespace {{ .Project }}.DomainModel;

public partial class BaseEntity
{
    protected BaseEntity()
    {
        Created = new TimeStamp();
        LastUpdated = new TimeStamp();
    }

    public bool Deleted { get; private set; }
    // Optimistic-concurrency token: bumped on every write so a stale edit is
    // detected (the UI carries the version it loaded and the update rejects it
    // if the row moved on).
    public int Version { get; private set; }
    public TimeStamp Created { get; private set; }
    public TimeStamp LastUpdated { get; private set; }
}
