@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
<nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(90deg, #4338ca, #6366f1);">
    <div class="container">
        <NavLink class="navbar-brand" href="/" Match="NavLinkMatch.All">{{ .Project }}</NavLink>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><NavLink class="nav-link" href="/" Match="NavLinkMatch.All">Home</NavLink></li>
                <!-- aspgen:nav -->
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    @Body
</main>

<footer class="text-center">
    <small>Generated by aspgen &middot; {{ .Project }}</small>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
